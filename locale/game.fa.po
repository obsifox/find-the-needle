msgstr "برای نگه داشتنش، آن را در ویترین بگذارید"

msgid "HELD x%d"
msgstr "در دست x%d"

msgid "FOUND x%d THIS RUN"
msgstr "در این دور x%d پیدا کرده‌اید"

msgid "DRAG TO TURN"
msgstr "برای چرخاندن بکشید"

msgid "WHEEL TO ZOOM"
msgstr "برای زوم، چرخ ماوس را بچرخانید"

msgid "F TO TAKE ONE"
msgstr "F برای برداشتن یکی"

msgid "%s OR ESC TO CLOSE"
msgstr "%s یا ESC برای بستن"

msgid "PRESS E OR ESC TO PUT IT BACK ON THE BOARD"
msgstr "برای گذاشتن دوباره‌اش روی تخته، E یا ESC را فشار دهید"

msgid "in the case from this load  ·  %d of %d kinds"
msgstr "در ویترین از این محموله  ·  %d از %d نوع"

msgid "No needle from this load is lying loose in the yard."
msgstr "هیچ سوزنی از این محموله در حیاط رها نیست."

msgid "%s is out in the yard, not in the case.%s"
msgstr "%s بیرون در حیاط است، نه در ویترین.%s"

msgid "%d needles you still need are out in the yard: %s.%s"
msgstr "%d سوزنی که هنوز لازم دارید بیرون در حیاط هستند: %s.%s"

msgid "One of them is packed inside a bale, a wrapped bale or a brick. Run it past a scanner, or hold X on it to tear it open."
msgstr "یکی از آن‌ها داخل یک عدل، عدل بسته‌بندی‌شده یا آجر قرار دارد. آن را از جلوی اسکنر رد کنید، یا X را رویش نگه دارید تا بازش کنید."

msgid "%d of them are packed inside bales, wrapped bales or bricks. Run them past a scanner, or hold X on one to tear it open."
msgstr "%d تای آن‌ها داخل عدل‌ها، عدل‌های بسته‌بندی‌شده یا آجرها بسته شده‌اند. آن‌ها را از جلوی اسکنر رد کنید، یا X را روی یکی نگه دارید تا بازش کنید."

msgid "YES, SEND IT BACK INTO THE STACK"
msgstr "بله، به توده برگردان"

msgid "RETURN %s TO THE STACK"
msgstr "%s را به توده برگردان"

msgid "RETURN %d NEEDLES TO THE STACK"
msgstr "%d سوزن را به توده برگردان"

msgid "RETURN A STUCK NEEDLE TO THE STACK"
msgstr "سوزن گیرکرده را به توده برگردان"

msgid "No needles are lying loose right now. If a needle gets stuck somewhere you cannot reach, press this to put it back into the pile."
msgstr "الان هیچ سوزنی رها نیست. اگر سوزنی جایی گیر کند که به آن نمی‌رسید، این را فشار دهید تا به توده برگردد."

msgid "This buries the needle in the pile again, and you will have to find it again. Press again to confirm."
msgstr "این کار سوزن را دوباره داخل توده دفن می‌کند و باید دوباره پیدایش کنید. برای تأیید، دوباره فشار دهید."

msgid "Back in the stack."
msgstr "به توده برگشت."

msgid "The pile is gone, so the needle is on the floor under this board."
msgstr "توده از بین رفته، پس سوزن روی کف زیر این تخته است."

msgid "%d back in the stack, %d on the floor under this board."
msgstr "%d تا به توده برگشت و %d تا روی کف زیر این تخته است."

msgid "It could not be moved. Nothing has changed."
msgstr "جابه‌جایش ممکن نشد. هیچ چیز تغییر نکرد."

msgid "RESTART TO SWITCH"
msgstr "برای تغییر، ری‌استارت کنید"

msgid "You are playing on %s now. The game switches to %s the next time it starts."
msgstr "الان روی %s بازی می‌کنید. دفعه بعد که بازی اجرا شود به %s سوییچ می‌کند."

msgid "The game is in %s now. It switches to %s the next time it starts."
msgstr "بازی الان در حالت %s است. دفعه بعد که اجرا شود به %s سوییچ می‌کند."

msgid "The render thread turns on the next time the game starts."
msgstr "ترد رندر دفعه بعد که بازی اجرا شود روشن می‌شود."

msgid "The render thread turns off the next time the game starts."
msgstr "ترد رندر دفعه بعد که بازی اجرا شود خاموش می‌شود."

msgid "Save and quit now, then start the game again. Or keep playing and switch later."
msgstr "الان ذخیره و خارج شوید، بعد بازی را دوباره اجرا کنید. یا به بازی ادامه دهید و بعداً سوییچ کنید."

msgid "Quit now, then start the game again. Or switch later."
msgstr "الان خارج شوید، بعد بازی را دوباره اجرا کنید. یا بعداً سوییچ کنید."

msgid "SAVE AND QUIT"
msgstr "ذخیره و خروج"

msgid "QUIT GAME"
msgstr "خروج از بازی"

msgid "LATER"
msgstr "بعداً"


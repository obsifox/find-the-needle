msgstr "در ویترین"

msgid "%d needle in the tray"
msgid_plural "%d needles in the tray"
msgstr[0] "%d سوزن در سینی"
msgstr[1] "%d سوزن در سینی"

msgid "YOUR HANDS ARE FULL"
msgstr "دست‌هایتان پر است"


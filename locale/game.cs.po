# Find The Needle, Czech.
#
# An empty msgstr is not a bug: it means the string falls back to its message
# id, which is the English source text. See docs/localization/PLAN.md.
#
# Czech has three plural forms, so every plural entry here carries three
# msgstr lines: [0] for one (1 jehla), [1] for 2 to 4 (2 jehly), [2] for
# everything else, 0 and 5 up included (5 jehel).
#
# To bring this file up to date after the English has moved:
#     python scripts/dev/gen_pot.py --merge cs
msgid ""
msgstr ""
"Project-Id-Version: Find The Needle\n"
"Language: cs\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"

msgid "SMALL"
msgstr "MALÁ"

msgid "Designed for weaker computers. A shorter hunt with room to walk around the pile."
msgstr "Pro slabší počítače. Kratší hledání a kolem hromady je dost místa na chození."

msgid "STANDARD"
msgstr "BĚŽNÁ"

msgid "The yard as it comes. The pile the game was built around, under one steel roof."
msgstr "Dvůr tak, jak je. Hromada, kolem které vznikla celá hra, pod jednou ocelovou střechou."

msgid "BIG"
msgstr "VELKÁ"

msgid "Twice the hay and a crown that stands over the wall plates. Bring a belt."
msgstr "Dvakrát víc sena a vršek, který trčí nad stěny. Bez pásu se neobejdeš."

msgid "HUGE"
msgstr "OBROVSKÁ"

msgid "Eight storeys of straw. The shed goes out to meet it and the roof still loses. Slow to load."
msgstr "Osm pater slámy. Seník se kvůli ní roztáhne a střecha stejně nestačí. Dlouho se načítá."

msgid "THE MOUNTAIN"
msgstr "HORA"

msgid "Fifty metres. It does not fit under the roof, it is not supposed to, and you will not finish it. Takes a minute to pour."
msgstr "Padesát metrů. Pod střechu se nevejde, ani nemá, a hotový s ní nikdy nebudeš. Nasypání trvá minutu."


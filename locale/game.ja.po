msgstr "全作業場   $%s稼いだ   %d時間%02d分プレイ"

msgid "WARMING UP"
msgstr "準備運動中"

msgid "RAISING THE SKY"
msgstr "空を持ち上げ中"

msgid "CLEARING THE YARD"
msgstr "作業場を片付け中"

msgid "ROLLING THE FIELDS"
msgstr "畑を広げ中"

msgid "SHAPING THE PILE"
msgstr "山の形を整え中"

msgid "SETTLING THE PILE"
msgstr "山を落ち着かせ中"

msgid "OPENING THE STAND"
msgstr "直売所を開店中"

msgid "FINDING YOU A PITCHFORK"
msgstr "ピッチフォークを探し中"

msgid "RESTORING THE YARD"
msgstr "作業場を元に戻し中"

msgid "HANGING THE SIGNS"
msgstr "看板を取り付け中"

msgid "TUNING THE RADIO"
msgstr "ラジオを合わせ中"

msgid "THE CLOCK IS OUT  ·  what happens next, you find out when the game is released"
msgstr "時間切れ  ·  この先どうなるかは、発売されてからのお楽しみ"

msgid "DEBUG MODE ACTIVATED  ·  F1"
msgstr "デバッグモード起動  ·  F1"

msgid "PAID $%s"
msgstr "$%sを支払った"

msgid "$%s ADDED TO WHAT YOU OWE"

msgstr "進み具合はセーブされている。順位はあとで出る"

msgid "YOUR RANK"
msgstr "自分の順位"

msgid "OPEN THE LEADERBOARDS TO SEE IT"
msgstr "ランキングを開いて確認しよう"

msgid "NO BOARDS"
msgstr "ランキングなし"


msgid_plural "1 wad · %d straw"
msgstr[0] "1 охапка · %d травинка"
msgstr[1] "1 охапка · %d травинки"
msgstr[2] "1 охапка · %d травинок"

msgid "Bare Hands"
msgstr "Голые руки"

msgid "Pick up hay with your hands and carry it to the selling stand."
msgstr "Бери сено руками и носи его к прилавку."

msgid "Pick up and carry hay"
msgstr "Брать и носить сено"

msgid "Bigger Handful"
msgstr "Больше в горсти"

msgid "Each level lets you hold more hay and grab more with each click, up to fifteen pieces."
msgstr "Каждый уровень позволяет держать больше травинок и брать больше за один клик, всего до пятнадцати."

msgid " in hand"
msgstr " в руке"

msgid "Unlocks the toy shovel in the shop. Digs %d straw at a time."
msgstr "Открывает в магазине игрушечную лопатку. Копает за раз травинок: %d."

msgid "SHOP · Toy Shovel · $%.2f"
msgstr "МАГАЗИН · Игрушечная лопатка · $%.2f"

msgid "Bigger Toy Shovel"
msgstr "Лопатка побольше"

msgid "Each level digs 3 more straw."
msgstr "Каждый уровень берёт на 3 соломинки больше."

msgid " a dig"
msgstr " за раз"

msgid "Unlocks the spade in the shop. Digs %d straw at a time."
msgstr "Открывает в магазине лопату. Копает за раз травинок: %d."

msgid "SHOP · Spade · $%d"
msgstr "МАГАЗИН · Лопата · $%d"

msgid "Bigger Spade"
msgstr "Лопата побольше"

msgid "Each level digs about 12% more straw."
msgstr "Каждый уровень копает примерно на 12% больше сена."

msgid "Unlocks the pitchfork in the shop. Lifts %d straw at a time."
msgstr "Открывает в магазине вилы. Поднимают за раз травинок: %d."

msgid "SHOP · Pitchfork · $%d"
msgstr "МАГАЗИН · Вилы · $%d"

msgid "Bigger Pitchfork"
msgstr "Вилы побольше"

msgid "Each level lifts about 12% more straw."
msgstr "Каждый уровень поднимает примерно на 12% больше сена."

msgid "Unlocks the broom in the shop. Pushes loose hay along the floor at %.1f m/s."
msgstr "Открывает в магазине метлу. Гонит рассыпное сено по полу со скоростью %.1f м/с."

msgid "SHOP · Broom · $%d"
msgstr "МАГАЗИН · Метла · $%d"

msgid "Better Broom"
msgstr "Метла получше"

msgid "Each level lets the broom sweep a wider patch of floor."
msgstr "С каждым уровнем метла метёт более широкую полосу пола."

msgid "Bucket Licence"
msgstr "Разрешение на ведро"

msgid "Unlocks the bucket in the shop. Holds %d pieces of hay and empties at %d a second."
msgstr "Открывает в магазине ведро. Вмещает травинок: %d, высыпает по %d в секунду."

msgid "SHOP · Bucket · $%d"
msgstr "МАГАЗИН · Ведро · $%d"

msgid "Bigger Bucket"
msgstr "Ведро побольше"

msgid "Each level lets the bucket hold about a third more hay."
msgstr "Каждый уровень добавляет ведру примерно треть вместимости."

msgid " pieces"
msgstr " штук"

msgid "Wheelbarrow Licence"
msgstr "Разрешение на тачку"

msgid "Unlocks the wheelbarrow in the shop. Holds %d pieces and empties at %d a second. A bucket empties at %d."
msgstr "Открывает в магазине тачку. Вмещает травинок: %d, высыпает по %d в секунду. Ведро высыпает по %d."

msgid "SHOP · Wheelbarrow · $%d"
msgstr "МАГАЗИН · Тачка · $%d"

msgid "Bigger Wheelbarrow"
msgstr "Тачка побольше"

msgid "Each level lets the wheelbarrow hold about a fifth more hay."
msgstr "Каждый уровень добавляет тачке примерно пятую часть вместимости."

msgid "Dump Hatch Plans"
msgstr "Чертёж сбросного люка"

msgid "Unlocks the Dump Hatch, $%d each. Walk up to it with a full bucket or barrow and it empties it onto the belt below for you."
msgstr "Открывает сбросной люк, $%d за штуку. Подойди к нему с полным ведром или тачкой, и он сам вывалит всё на ленту снизу."

msgid "BUILD · Dump Hatch · $%d"
msgstr "СТРОЙКА · Сбросной люк · $%d"

msgid "Smooth Pouring"
msgstr "Ровная струя"

msgid "Each level makes buckets and barrows empty 12% faster. The numbers below are for the bucket."
msgstr "Каждый уровень ускоряет вёдра и тачки на 12%. Цифры ниже даны для ведра."

msgid " a second"
msgstr " в секунду"

msgid "Yard Vac Licence"
msgstr "Разрешение на пылесос"

msgid "Unlocks the yard vac in the shop, $%d. Hold left click to suck up hay from the floor or the pile at %d a second. Holds %d pieces. Hold right click to pour it out, or aim at a tipper, a bucket or a barrow to empty it straight in."
msgstr "Открывает в магазине пылесос, $%d. Держи левую кнопку, чтобы втягивать сено с пола или из кучи по %d в секунду. Вмещает травинок: %d. Держи правую кнопку, чтобы высыпать, а если навести его на сбросной люк, ведро или тачку, сено высыплется прямо туда."

msgid "SHOP · Yard Vac · $%d"
msgstr "МАГАЗИН · Пылесос · $%d"

msgid "Bigger Vac Bin"
msgstr "Бак пылесоса больше"

msgid "Each level lets the yard vac hold 500 more pieces."
msgstr "Каждый уровень добавляет пылесосу ещё 500 травинок."

msgid "Stronger Suction"
msgstr "Сильнее тяга"

msgid "Each level makes the yard vac suck up hay 25% faster, from a wider patch."
msgstr "Каждый уровень ускоряет всасывание на 25% и расширяет место, откуда пылесос тянет сено."

msgid "Lighter Licence"
msgstr "Разрешение на зажигалку"

msgid "Unlocks the lighter in the shop, $%d. Burns about %d strands. Can be used every %d seconds."
msgstr "Открывает в магазине зажигалку, $%d. Сжигает примерно травинок: %d. Пользоваться можно раз в %d с."

msgid "SHOP · Lighter · $%d"
msgstr "МАГАЗИН · Зажигалка · $%d"

msgid "Conveyor Plans"
msgstr "Чертёж конвейера"

msgid "Unlocks conveyor belts, $%d a metre. Belts move hay at %.1f m/s."
msgstr "Открывает конвейерные ленты, $%d за метр. Лента везёт сено со скоростью %.1f м/с."

msgid "BUILD · Conveyor Belt · $%d per metre"
msgstr "СТРОЙКА · Конвейер · $%d за метр"

msgid "Enclosed Conveyor Plans"
msgstr "Чертёж закрытого конвейера"

msgid "Unlocks enclosed conveyors, $%d a metre. Packaged cargo travels without visible moving objects, which saves performance in large factories. Loose hay cannot enter."
msgstr "Открывает закрытые конвейеры, $%d за метр. Упакованный груз едет без видимых движущихся вещей, и на большой фабрике игра идёт быстрее. Рассыпное сено внутрь не попадёт."

msgid "BUILD · Enclosed Conveyor · $%d per metre"
msgstr "СТРОЙКА · Закрытый конвейер · $%d за метр"

msgid "Faster Belt Motor"
msgstr "Мотор ленты быстрее"

msgid "Each level makes all belts 45% faster, including ones already built."
msgstr "Каждый уровень ускоряет все ленты на 45%, в том числе уже построенные."

msgid "Platform Plans"
msgstr "Чертёж платформы"

msgid "Unlocks platforms, $%d a square metre. You and your machines can stand on them."
msgstr "Открывает платформы, $%d за квадратный метр. На них можешь стоять ты и твои машины."

msgid "BUILD · Platform · $%d per m2"
msgstr "СТРОЙКА · Платформа · $%d за м2"

msgid "Stairs and Railings"
msgstr "Лестницы и перила"

msgid "Unlocks stairs ($%d a metre of height) and railings ($%d a metre). Railings are %.2f m tall."
msgstr "Открывает лестницы ($%d за метр высоты) и перила ($%d за метр). Высота перил: %.2f м."

msgid "BUILD · Stair $%d/m rise · Railing $%d/m"
msgstr "СТРОЙКА · Лестница $%d/м высоты · Перила $%d/м"

msgid "Unlocks the Paint Board, $%d. Hold left click to draw and right click to erase."
msgstr "Открывает белую доску, $%d. Держи левую кнопку, чтобы рисовать, и правую, чтобы стирать."

msgid "BUILD · Paint Board · $%d"
msgstr "СТРОЙКА · Белая доска · $%d"

msgid "Wall Plans"
msgstr "Чертёж стены"

msgid "Unlocks walls, window walls and doorways, $%d a metre."
msgstr "Открывает стены, стены с окнами и дверные проёмы, $%d за метр."

msgid "BUILD · Wall · Window Wall · $%d per metre"
msgstr "СТРОЙКА · Стена · Стена с окном · $%d за метр"

msgid "Roof Plans"
msgstr "Чертёж крыши"

msgid "Unlocks flat roofs, angled roofs and roof hatches, $%d a metre. Climb onto the roof through a hatch."
msgstr "Открывает плоские крыши, скатные крыши и люки, $%d за метр. Через люк можно выбраться на крышу."

msgid "BUILD · Roof · Angled Roof · Roof Hatch · $%d per metre"
msgstr "СТРОЙКА · Крыша · Скатная крыша · Люк в крыше · $%d за метр"

msgid "Unlocks the Work Lamp. Lights up to %d m. Press %s at it to change the brightness. Needs no power. $%d each."
msgstr "Открывает рабочую лампу. Светит на %d м. Нажми %s рядом с ней, чтобы поменять яркость. Энергия не нужна. $%d за штуку."

msgid "BUILD · Work Lamp · $%d"
msgstr "СТРОЙКА · Рабочая лампа · $%d"

msgid "Alternating Splitter"
msgstr "Чередующийся делитель"

msgid "Unlocks the splitter, $%d. Splits one belt into two: one load left, the next load right. It can also send everything one way."
msgstr "Открывает делитель, $%d. Делит одну ленту надвое: один груз налево, следующий направо. Ещё его можно заставить гнать всё в одну сторону."

msgid "BUILD · Belt Splitter · $%d"
msgstr "СТРОЙКА · Делитель ленты · $%d"

msgid "Splitter Priority"
msgstr "Приоритет делителя"

msgid "Adds a priority setting to every splitter. The chosen side gets all the hay. The other side only gets hay when the first one is backed up."
msgstr "Добавляет каждому делителю настройку приоритета. Выбранная сторона забирает всё сено. Вторая получает его, только когда первая забита."

msgid "SPLITTERS · Priority · one side gets hay first"
msgstr "ДЕЛИТЕЛИ · Приоритет · одна сторона получает сено первой"

msgid "Unlocks the T Junction, $%d. It sets itself up from the belts you connect: bring one belt in and it splits it into two, bring two belts in and it joins them into one."
msgstr "Открывает T узел, $%d. Он сам настраивается по лентам, которые ты подключишь: подведи одну ленту, и он разделит её на две, подведи две ленты, и он соединит их в одну."

msgid "BUILD · T Junction · $%d"
msgstr "СТРОЙКА · T узел · $%d"

msgid "Compact Splitter Plans"
msgstr "Чертёж компактного делителя"

msgid "Unlocks the Compact Splitter, $%d. Shares one belt between three belts, taking turns. Works with open and enclosed belts."
msgstr "Открывает компактный делитель, $%d. Раздаёт одну ленту на три по очереди. Работает и с открытыми, и с закрытыми лентами."

msgid "BUILD · Compact Splitter · $%d"
msgstr "СТРОЙКА · Компактный делитель · $%d"

msgid "Smart Splitter Plans"
msgstr "Чертёж умного делителя"

msgid "Unlocks the Smart Splitter, $%d. You pick what may leave through each of its three outputs, so one belt can be sorted by type."
msgstr "Открывает умный делитель, $%d. Ты сам выбираешь, что может выйти через каждый из трёх выходов, и одна лента разбирается по типам."

msgid "BUILD · Smart Splitter · $%d"
msgstr "СТРОЙКА · Умный делитель · $%d"

msgid "Unlocks the joiner, $%d. Merges two belts into one."
msgstr "Открывает соединитель, $%d. Сводит две ленты в одну."

msgid "BUILD · Belt Joiner · $%d"
msgstr "СТРОЙКА · Соединитель лент · $%d"

msgid "Compressor Plans"
msgstr "Чертёж сенного пресса"

msgid "Unlocks the Hay Compressor, $%d. Presses %d straw into a bale every %.1f seconds. Bales sell for %.1fx the price of loose hay."
msgstr "Открывает сенной пресс, $%d. Травинок на тюк: %d, и новый тюк выходит каждые %.1f с. Тюк продаётся в %.1f раза дороже рассыпного сена."

msgid "BUILD · Hay Compressor · $%d"
msgstr "СТРОЙКА · Сенной пресс · $%d"

msgid "Larger Bale Chamber"
msgstr "Камера тюка больше"

msgid "Each level puts 25% more hay into every bale, so each bale is worth more."
msgstr "Каждый уровень кладёт в тюк на 25% больше сена, и тюк стоит дороже."

msgid " a bale"
msgstr " на тюк"

msgid "Faster Bale Press"
msgstr "Сенной пресс быстрее"

msgid "Each level makes every compressor 8% faster."
msgstr "Каждый уровень ускоряет все прессы на 8%."

msgid " s a bale"
msgstr " с на тюк"

msgid "Raise Bale Quality"
msgstr "Качество тюков выше"

msgid "Each level makes bales sell for about 7% more."
msgstr "Каждый уровень поднимает цену тюка примерно на 7%."

msgid " the hay value"
msgstr " от цены сена"

msgid "Wrapper Plans"
msgstr "Чертёж обмотчика"

msgid "Unlocks the Hay Wrapper, $%d. Wraps a bale every %.2f seconds. Takes bales only. Wrapped bales sell for %.2fx a bale, which is %.2fx the price of loose hay."
msgstr "Открывает обмотчик тюков, $%d. Обматывает тюк каждые %.2f с. Принимает только тюки. Обмотанный тюк стоит в %.2f раза дороже обычного, то есть в %.2f раза дороже рассыпного сена."

msgid "BUILD · Hay Wrapper · $%d"
msgstr "СТРОЙКА · Обмотчик тюков · $%d"

msgid "Faster Wrapper"
msgstr "Обмотчик быстрее"

msgid "Each level makes every wrapper 12% faster. At the top it keeps up with a fully upgraded compressor."
msgstr "Каждый уровень ускоряет все обмотчики на 12%. На максимуме обмотчик успевает за полностью прокачанным прессом."

msgid "Better Wrap"
msgstr "Плёнка получше"

msgid "Each level makes wrapped bales sell for more."
msgstr "Каждый уровень поднимает цену обмотанных тюков."

msgid " the bale value"
msgstr " от цены тюка"

msgid "Hay Silo Plans"
msgstr "Чертёж хранилища"

msgid "Unlocks the Hay Silo, $%d. Put it in a belt line to store hay. Press %s at it to set how fast hay comes out, up to %d loads a minute. Holds %d loads."
msgstr "Открывает хранилище сена, $%d. Поставь его в линию конвейера, чтобы копить сено. Нажми %s рядом с ним, чтобы задать, как быстро сено выходит, до %d грузов в минуту. Вмещает грузов: %d."

msgid "BUILD · Hay Silo · $%d"
msgstr "СТРОЙКА · Хранилище сена · $%d"

msgid "Faster Silo Output"
msgstr "Выдача хранилища быстрее"

msgid "Each level raises the silo's top speed by 20 loads a minute."
msgstr "Каждый уровень поднимает предел хранилища на 20 грузов в минуту."

msgid " loads a minute"
msgstr " грузов в минуту"

msgid "Bigger Silo"
msgstr "Хранилище побольше"

msgid "Each level lets a silo hold about a quarter more."
msgstr "Каждый уровень добавляет хранилищу примерно четверть вместимости."

msgid " loads"
msgstr " грузов"

msgid "Fuller Silo Loads"
msgstr "Грузы хранилища полнее"

msgid "Each level puts 25% more loose hay into every load the silo lets out. Bales and bricks do not change."
msgstr "Каждый уровень кладёт в каждый груз хранилища на 25% больше рассыпного сена. Тюки и брикеты не меняются."

msgid " a load"
msgstr " на груз"

msgid "Unlocks Hay Stairs, $%d. Belts cannot go down slopes steeper than %d degrees. Drop hay in the top and it comes out on a belt at the bottom."
msgstr "Открывает сеноспуск, $%d. Ленты не идут под уклон круче %d°. Кидай сено сверху, и оно выйдет на ленту внизу."

msgid "BUILD · Hay Stairs · $%d"
msgstr "СТРОЙКА · Сеноспуск · $%d"

msgid "Unlocks the Hay Lift, from $%d. Carries hay straight up. Click the bottom, look up and click the top. Lifts %s m, and each extra metre costs $%d."
msgstr "Открывает сенолифт, от $%d. Поднимает сено прямо вверх. Щёлкни по низу, посмотри вверх и щёлкни по верху. Поднимает на %s м, каждый лишний метр стоит $%d."

msgid "BUILD · Hay Lift · from $%d"
msgstr "СТРОЙКА · Сенолифт · от $%d"

msgid "Pelletizer Plans"
msgstr "Чертёж брикетировщика"

msgid "Unlocks the Hay Pelletizer, $%d. Turns %d straw into a fuel brick every %.1f seconds and throws it out. Bricks sell for %.1fx the price of loose hay."
msgstr "Открывает брикетировщик, $%d. Травинок на брикет: %d, новый брикет выходит каждые %.1f с и вылетает наружу. Брикет стоит в %.1f раза дороже рассыпного сена."

msgid "BUILD · Hay Pelletizer · $%d"
msgstr "СТРОЙКА · Брикетировщик · $%d"

msgid "Tube Launcher Plans"
msgstr "Чертёж пневмопушки"

msgid "Unlocks the Tube Launcher, $%d. Throws whatever a belt brings it. Set the angle and power at the machine."
msgstr "Открывает пневмопушку, $%d. Кидает всё, что привозит лента. Угол и силу броска задай прямо на машине."

msgid "BUILD · Tube Launcher · $%d"
msgstr "СТРОЙКА · Пневмопушка · $%d"

msgid "Electricity"
msgstr "Электричество"

msgid "Unlocks the Hay Generator ($%d) and Power Poles ($%d). The generator burns hay and makes %.0f kW. Machines within %d m of a pole get power. Belts do not need power."
msgstr "Открывает сенной генератор ($%d) и столбы ($%d). Генератор жжёт сено и выдаёт %.0f кВт. Машины в радиусе %d м от столба получают энергию. Лентам энергия не нужна."

msgid "BUILD · Hay Generator · $%d · Power Pole · $%d"
msgstr "СТРОЙКА · Сенной генератор · $%d · Столб · $%d"

msgid "Carries power. Poles up to %d m apart connect. Machines within %d m get power if nothing blocks the wire. Comes with Electricity."
msgstr "Передаёт энергию. Столбы соединяются, если между ними не больше %d м. Машины в радиусе %d м получают энергию, если провод ничем не перекрыт. Идёт вместе с Электричеством."

msgid "BUILD · Power Pole · $%d"
msgstr "СТРОЙКА · Столб · $%d"

msgid "Stronger Generator"
msgstr "Генератор мощнее"

msgid "Each level raises how much power a generator can make. It still needs enough hay to get there."
msgstr "Каждый уровень поднимает предел мощности генератора. Сена всё равно должно хватать."

msgid "Borehole Plans"
msgstr "Чертёж скважины"

msgid "Unlocks the Borehole Pump, $%d. Pumps %.0f litres of water a second and uses %.0f kW. Pipe the water to a pulper."
msgstr "Открывает скважинный насос, $%d. Качает воду: %.0f л в секунду, потребляет %.0f кВт. Проведи воду трубой к мешалке."

msgid "BUILD · Borehole Pump · $%d"
msgstr "СТРОЙКА · Скважинный насос · $%d"

msgid "Deeper Bore"
msgstr "Скважина глубже"

msgid "Each level makes every pump bring up more water. It does not use more power."
msgstr "Каждый уровень поднимает подачу воды у всех насосов. Энергии при этом уходит столько же."

msgid " litres a second"
msgstr " л в секунду"

msgid "Water Mains"
msgstr "Водопровод"

msgid "Unlocks water pipes, $%d a metre. Click the shiny flange on one machine, then on another. Both ends must be on a flange."
msgstr "Открывает водяные трубы, $%d за метр. Щёлкни по блестящему фланцу на одной машине, потом на другой. Оба конца должны лечь на фланец."

msgid "BUILD · Water Pipe · $%d/m"
msgstr "СТРОЙКА · Водяная труба · $%d/м"

msgid "Gas Plant Plans"
msgstr "Чертёж газовой станции"

msgid "Unlocks the Gas Plant, $%d. It burns only eco bricks and gets %d times as much power from each straw as a Hay Generator. Makes up to %.0f kW and needs %.0f litres of water a second, so pipe it from a pump."
msgstr "Открывает газовую станцию, $%d. Жжёт только эко-брикеты и получает с каждой травинки в %d раза больше энергии, чем сенной генератор. Выдаёт до %.0f кВт, и ей нужно %.0f л воды в секунду, так что проведи к ней трубу от насоса."

msgid "BUILD · Gas Plant · $%d"
msgstr "СТРОЙКА · Газовая станция · $%d"

msgid "Bigger Gas Plant"
msgstr "Газовая станция побольше"

msgid "Each level raises how much power a gas plant can make. It needs more bricks and more water to get there."
msgstr "Каждый уровень поднимает предел мощности газовой станции. Для этого ей нужно больше брикетов и больше воды."

msgid "Longer Spans"
msgstr "Пролёты длиннее"

msgid "Each level lets poles and cable boxes connect from 1.5 m further apart."
msgstr "Каждый уровень добавляет 1.5 м к расстоянию между столбами и кабельными ящиками."

msgid " m between poles"
msgstr " м между столбами"

msgid "Longer Drops"
msgstr "Отводы длиннее"

msgid "Each level lets poles and cable boxes power machines 1 m further away."
msgstr "Каждый уровень добавляет 1 м к радиусу, в котором столбы и ящики питают машины."

msgid " m to a machine"
msgstr " м до машины"

msgid "Underground Cable"
msgstr "Подземный кабель"

msgid "Unlocks Cable Boxes, $%d. Works like a pole, but the cable is underground so walls cannot block it. Connects up to %d m away and powers machines within %d m. Hold one to see the cables."
msgstr "Открывает кабельные ящики, $%d. Работает как столб, но кабель идёт под землёй, и стены его не перекроют. Тянется на %d м и питает машины в радиусе %d м. Возьми ящик в руки, чтобы увидеть кабели."

msgid "BUILD · Cable Box · $%d"
msgstr "СТРОЙКА · Кабельный ящик · $%d"

msgid "Bigger Firebox"
msgstr "Топка больше"

msgid "Each level lets generators hold 25%% more hay. A full generator now lasts %d minutes at full power, and about %d minutes at max level."
msgstr "Каждый уровень позволяет генератору держать на 25%% больше сена. Полный генератор тянет на полной мощности %d мин, а на максимальном уровне примерно %d мин."

msgid " in the box"
msgstr " в топке"

msgid "Bigger Brick Die"
msgstr "Форма брикета больше"

msgid "Each level puts 25%% more hay into every brick, so bricks sell for more and burn longer. A feed disc still takes %d bricks, so discs are worth more too."
msgstr "Каждый уровень кладёт в брикет на 25%% больше сена, и брикет стоит дороже и горит дольше. На кормовой диск по-прежнему идёт брикетов: %d, так что и диски дорожают."

msgid " a brick"
msgstr " на брикет"

msgid "Faster Grinding"
msgstr "Помол быстрее"

msgid "Each level makes every pelletizer 8% faster."
msgstr "Каждый уровень ускоряет все брикетировщики на 8%."

msgid " s a brick"
msgstr " с на брикет"

msgid "Raise Brick Quality"
msgstr "Качество брикетов выше"

msgid "Each level makes bricks sell for about 6% more."
msgstr "Каждый уровень поднимает цену брикета примерно на 6%."

msgid "Pulper Plans"
msgstr "Чертёж мешалки"

msgid "BUILD · Hay Pulper · $%d"
msgstr "СТРОЙКА · Сенная мешалка · $%d"

msgid "Bigger Pulp Slabs"
msgstr "Плиты массы больше"

msgid "Each level puts 25% more hay into every slab. Slabs sell for more and use the same water."
msgstr "Каждый уровень кладёт в плиту на 25% больше сена. Плита стоит дороже, а воды уходит столько же."

msgid " a slab"
msgstr " на плиту"

msgid "Faster Drum"
msgstr "Барабан быстрее"

msgid "Each level makes every pulper 8% faster. A faster pulper also uses water faster."
msgstr "Каждый уровень ускоряет все мешалки на 8%. Быстрая мешалка и воду тратит быстрее."

msgid " s a slab"
msgstr " с на плиту"

msgid "Raise Pulp Quality"
msgstr "Качество массы выше"

msgid "Each level makes slabs sell for more."
msgstr "Каждый уровень поднимает цену плит."

msgid "Paper Mill Plans"
msgstr "Чертёж бумажного цеха"

msgid "BUILD · Paper Mill · $%d"
msgstr "СТРОЙКА · Бумажный цех · $%d"

msgid "Faster Winder"
msgstr "Намотка быстрее"

msgid "Each level makes every paper mill 8% faster. It also uses slabs faster."
msgstr "Каждый уровень ускоряет все бумажные цеха на 8%. Плиты при этом тратятся быстрее."

msgid " s a roll"
msgstr " с на рулон"

msgid "Finer Paper"
msgstr "Бумага тоньше"

msgid "Each level makes paper rolls sell for more."
msgstr "Каждый уровень поднимает цену рулонов бумаги."

msgid " the slab value"
msgstr " от цены плит"

msgid "Feed Disc Press Plans"
msgstr "Чертёж дискового пресса"

msgid "Unlocks the Feed Disc Press, $%d. Presses hay from one belt and eco bricks from another into feed discs. Discs sell for %.2fx the price of loose hay. Each disc uses %d straw and %d bricks. Any size of brick counts as one brick. It is %d m long, has a side input and uses %.1f kW."
msgstr "Открывает дисковый пресс, $%d. Прессует сено с одной ленты и эко-брикеты с другой в кормовые диски. Диск стоит в %.2f раза дороже рассыпного сена. На диск уходит травинок: %d и брикетов: %d. Брикет любого размера считается за один. Длина: %d м, вход сбоку, потребляет %.1f кВт."

msgid "BUILD · Feed Disc Press · $%d"
msgstr "СТРОЙКА · Дисковый пресс · $%d"

msgid "Faster Disc Press"
msgstr "Дисковый пресс быстрее"

msgid "Each level makes every disc press 8% faster. It also uses hay and bricks faster."
msgstr "Каждый уровень ускоряет все дисковые прессы на 8%. Сено и брикеты при этом тратятся быстрее."

msgid " s a disc"
msgstr " с на диск"

msgid "Better Feed"
msgstr "Корм получше"

msgid "Each level makes feed discs sell for more."
msgstr "Каждый уровень поднимает цену кормовых дисков."

msgid " the loose hay value"
msgstr " от цены рассыпного сена"

msgid "Extend the Shed"
msgstr "Расширить ангар"

msgid "Each level makes the shed 6 m wider and 6 m longer."
msgstr "Каждый уровень делает ангар на 6 м шире и на 6 м длиннее."

msgid " m across"
msgstr " м в ширину"

msgid "Waste Less Material"
msgstr "Меньше отходов"

msgid "Each level takes 5% off the price of belts, platforms, stairs, railings, walls and roofs. Machines still cost full price."
msgstr "Каждый уровень снимает 5% с цены лент, платформ, лестниц, перил, стен и крыш. Машины по-прежнему стоят полную цену."

msgid "Hay Piston Rake"
msgstr "Поршневые грабли"

msgid "Unlocks the Piston Rake, $%d. Digs into the pile and throws the hay behind it every %.1f seconds. Throws %d straw at a time and uses %.0f kW, or %.0f kW with Wider Rake Head. Must face the pile."
msgstr "Открывает поршневые грабли, $%d. Каждые %.1f с они врезаются в кучу и кидают сено назад. За раз летит травинок: %d, а уходит %.0f кВт, или %.0f кВт с широкой головкой грабель. Грабли должны смотреть на кучу."

msgid "BUILD · Piston Rake · $%d"
msgstr "СТРОЙКА · Поршневые грабли · $%d"

msgid "Wider Rake Head"
msgstr "Широкая головка грабель"

msgid "Level 1 raises each throw from %d straw to 50, and each rake then uses %.0f kW instead of %.0f kW. Each level after that adds 25%%."
msgstr "Первый уровень поднимает бросок с %d травинок до 50, и каждые грабли потом берут %.0f кВт вместо %.0f кВт. Каждый следующий добавляет 25%%."

msgid " a stroke"
msgstr " за взмах"

msgid "Faster Rake"
msgstr "Грабли быстрее"

msgid "Each level makes every rake 8% faster."
msgstr "Каждый уровень ускоряет все грабли на 8%."

msgid " s a stroke"
msgstr " с на взмах"

msgid "Rake Wheels"
msgstr "Колёса для граблей"

msgid "Adds Forward and Back buttons to every piston rake. Move a rake a little closer to the pile without taking it down. It stops by itself if something is in the way."
msgstr "Добавляет всем поршневым граблям кнопки Вперёд и Назад. Подвинь грабли чуть ближе к куче, не разбирая их. Они сами остановятся, если что-то мешает."

msgid "RAKES · Forward and Back · move without taking down"
msgstr "ГРАБЛИ · Вперёд и Назад · двигать без разборки"

msgid "Small Arm Plans"
msgstr "Чертёж малой руки"

msgid "Unlocks the Small Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second)."
msgstr "Открывает малую роборуку, $%d. Достаёт на %.2f м и переносит травинок: %d каждые %.2f с (%.1f в секунду)."

msgid "BUILD · Small Arm · $%d"
msgstr "СТРОЙКА · Малая рука · $%d"

msgid "Standard Arm Plans"
msgstr "Чертёж обычной руки"

msgid "Unlocks the Standard Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second, %d%% more). Uses %.1f kW instead of %.1f. Arms you already built stay the size they are."
msgstr "Открывает обычную роборуку, $%d. Достаёт на %.2f м и переносит травинок: %d каждые %.2f с (%.1f в секунду, на %d%% больше). Потребляет %.1f кВт вместо %.1f. Уже построенные роборуки не меняют размер."

msgid "BUILD · Standard Arm · $%d"
msgstr "СТРОЙКА · Обычная рука · $%d"

msgid "Long-Reach Arm Plans"
msgstr "Чертёж длинной руки"

msgid "Unlocks the Long-Reach Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second, %d%% more). Uses %.1f kW instead of %.1f. Arms you already built stay the size they are."
msgstr "Открывает длинную роборуку, $%d. Достаёт на %.2f м и переносит травинок: %d каждые %.2f с (%.1f в секунду, на %d%% больше). Потребляет %.1f кВт вместо %.1f. Уже построенные роборуки не меняют размер."

msgid "BUILD · Long-Reach Arm · $%d"
msgstr "СТРОЙКА · Длинная рука · $%d"

msgid "Belt Links"
msgstr "Связка лент"

msgid "Choose the belts an arm works with. It takes from one belt and puts on another. Tick one kind on its plate and it sorts that kind off the belt."
msgstr "Выбери ленты, с которыми работает рука. Она берёт с одной ленты и кладёт на другую. Отметь на ней один вид, и она будет снимать с ленты только его."

msgid "ARMS · Belt Links · choose where it takes and puts"
msgstr "РУКИ · Связка лент · выбери, откуда брать и куда класть"

msgid "Overflow Arm"
msgstr "Рука для заторов"

msgid "An arm can leave a belt alone while it moves, and only take from it when the belt gets stuck. Tick it under TAKE FROM on the arm."
msgstr "Рука может не трогать ленту, пока та едет, и брать с неё только когда лента встала. Отметь это на руке под БЕРЁТ С."

msgid "ARMS · Overflow · helps out when a belt gets stuck"
msgstr "РУКИ · Заторы · помогает, когда лента встала"

msgid "Pick Order"
msgstr "Порядок захвата"

msgid "Choose what each arm grabs first: loose hay, the biggest things, or whatever is closest. Needles always come first."
msgstr "Выбери, что каждая рука хватает первым: рассыпное сено, самое большое или самое близкое. Иглы всегда первые."

msgid "ARMS · Pick Order · choose what it grabs first"
msgstr "РУКИ · Порядок захвата · выбери, что брать первым"

msgid "Hay Drone Plans"
msgstr "Чертёж сенного дрона"

msgid "Unlocks the Hay Drone, $%d. Each extra drone costs %.2fx the last. Give it a zone on the pile and a drop point up to %.0f m away: it digs the zone and flies the hay to the drop."
msgstr ""

msgid "BUILD · Hay Drone · $%d"
msgstr "СТРОЙКА · Сенной дрон · $%d"

msgid "Drone Pickup"
msgstr ""

msgid "Drones can collect things as well as dig. Tick what a drone picks up (wads, bales, bricks and more) and it carries them from its zone to its drop."
msgstr ""

msgid "DRONES · Pickup · collect what you tick"
msgstr ""

msgid "Longer Range"
msgstr ""

msgid "Each level lets every drone work %.1f m farther from its pad, and makes its zone %.1f m bigger."
msgstr ""

msgid " m reach"
msgstr " м радиус"

msgid "Faster Rotors"
msgstr "Винты быстрее"

msgid "Each level makes every drone fly 8% faster."
msgstr "Каждый уровень ускоряет полёт всех дронов на 8%."

msgid "Arm Speed"
msgstr "Скорость роборук"

msgid "Each level makes every arm 8% faster."
msgstr "Каждый уровень ускоряет все роборуки на 8%."

msgid " faster"
msgstr " быстрее"

msgid "Arm Carry Size"
msgstr "Захват роборук"

msgid "Each level lets every arm carry 8% more."
msgstr "Каждый уровень позволяет каждой роборуке нести на 8% больше."

msgid "Scanner Mk I Plans"
msgstr "Чертёж сканера Mk I"

msgid "Unlocks the Scanner Mk I, $%d. Put it on a belt. Checks %d straw every %.1f seconds (%.1f a second) for needles. Stops the belt when it finds one, until you empty the drawer. The drawer holds %d."
msgstr "Открывает сканер Mk I, $%d. Поставь его на ленту. Проверяет на иглы травинок: %d каждые %.1f с (%.1f в секунду). Найдя иглу, останавливает ленту, пока ты не опустошишь ящик. Ящик вмещает игл: %d."

msgid "BUILD · Scanner Mk I · $%d"
msgstr "СТРОЙКА · Сканер Mk I · $%d"

msgid "Unlocks the Needle Cabinet, $%d. One per yard. Has a slot for each of the %d kinds of needle."
msgstr "Открывает шкаф для игл, $%d. Один на весь двор. В нём по ячейке на каждый вид игл, а видов: %d."

msgid "BUILD · Needle Cabinet · $%d"
msgstr "СТРОЙКА · Шкаф для игл · $%d"

msgid "Scanner Mk II Plans"
msgstr "Чертёж сканера Mk II"

msgid "Upgrades all scanners to Mk II, $%d. Does not stop the belt when it finds a needle. Checks %.1f straw a second (Mk I: %.1f, so %d%% faster) and a bale in %.1f seconds (Mk I: %.1f)."
msgstr "Улучшает все сканеры до Mk II, $%d. Найдя иглу, ленту не останавливает. Проверяет %.1f травинок в секунду (у Mk I: %.1f, то есть на %d%% быстрее) и тюк за %.1f с (у Mk I: %.1f)."

msgid "UPGRADE · Scanner Mk II · $%d  ·  every scanner you own"
msgstr "УЛУЧШЕНИЕ · Сканер Mk II · $%d  ·  все твои сканеры"

msgid "Satellite Dish Mk I Plans"
msgstr "Чертёж антенны Mk I"

msgid "Unlocks the Satellite Dish, $%d. One per yard. Scans the pile and puts a circle around every needle within %d m for %d seconds. Recharges in %d seconds."
msgstr "Открывает антенну, $%d. Одна на весь двор. Просвечивает кучу и обводит кружком каждую иглу в радиусе %d м, и кружки держатся %d с. Перезаряжается за %d с."

msgid "BUILD · Satellite Dish · $%d"
msgstr "СТРОЙКА · Антенна · $%d"

msgid "Satellite Dish Mk II Plans"
msgstr "Чертёж антенны Mk II"

msgid "Upgrades the dish. Shows the exact spot of every needle in range for %d seconds."
msgstr "Улучшает антенну. Показывает точное место каждой иглы в радиусе действия, и держится это %d с."

msgid "UPGRADE · Satellite Dish Mk II  ·  exact spots"

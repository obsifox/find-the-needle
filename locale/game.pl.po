msgid "finding and scanning needles"
msgstr "szukanie i skanowanie igieł"

msgid "Arm upgrades"
msgstr "Ulepszenia ramienia"

msgid "Rake upgrades"
msgstr "Ulepszenia grabi"

msgid "Generator upgrades"
msgstr "Ulepszenia generatora"

msgid "Scanner upgrades"
msgstr "Ulepszenia skanera"

msgid "Belt upgrades"
msgstr "Ulepszenia taśm"

msgid "Not available in Demo"
msgstr "Niedostępne w wersji demo"

msgid "Not on this site"
msgstr "Nie w tym miejscu"

msgid "%d straw"
msgid_plural "%d straw"
msgstr[0] "%d źdźbło"
msgstr[1] "%d źdźbła"
msgstr[2] "%d źdźbeł"

msgid "1 wad · %d straw"
msgid_plural "1 wad · %d straw"
msgstr[0] "1 kłąb · %d źdźbło"
msgstr[1] "1 kłąb · %d źdźbła"
msgstr[2] "1 kłąb · %d źdźbeł"

msgid "Bare Hands"
msgstr "Gołe ręce"

msgid "Pick up hay with your hands and carry it to the selling stand."
msgstr "Podnoś siano rękami i zanoś je do stoiska."

msgid "Pick up and carry hay"
msgstr "Podnoś i noś siano"

msgid "Bigger Handful"
msgstr "Większa garść"

msgid "Each level lets you hold more hay and grab more with each click, up to fifteen pieces."
msgstr "Z każdym poziomem trzymasz więcej siana i bierzesz więcej jednym kliknięciem, maksymalnie piętnaście kawałków."

msgid " in hand"
msgstr " w rękach"

msgid "Unlocks the toy shovel in the shop. Digs %d straw at a time."
msgstr "Odblokowuje łopatkę w sklepie. Nabiera %d źdźbeł naraz."

msgid "SHOP · Toy Shovel · $%.2f"
msgstr "SKLEP · Łopatka · $%.2f"

msgid "Bigger Toy Shovel"
msgstr "Większa łopatka"

msgid "Each level digs 3 more straw."
msgstr "Każdy poziom nabiera 3 źdźbła więcej."

msgid " a dig"
msgstr " naraz"

msgid "Unlocks the spade in the shop. Digs %d straw at a time."
msgstr "Odblokowuje szpadel w sklepie. Nabiera %d źdźbeł naraz."

msgid "SHOP · Spade · $%d"
msgstr "SKLEP · Szpadel · $%d"

msgid "Bigger Spade"
msgstr "Większy szpadel"

msgid "Each level digs about 12% more straw."
msgstr "Każdy poziom nabiera około 12% więcej źdźbeł."

msgid "Unlocks the pitchfork in the shop. Lifts %d straw at a time."
msgstr "Odblokowuje widły w sklepie. Podnoszą %d źdźbeł naraz."

msgid "SHOP · Pitchfork · $%d"
msgstr "SKLEP · Widły · $%d"

msgid "Bigger Pitchfork"
msgstr "Większe widły"

msgid "Each level lifts about 12% more straw."
msgstr "Każdy poziom podnosi około 12% więcej źdźbeł."

msgid "Unlocks the broom in the shop. Pushes loose hay along the floor at %.1f m/s."
msgstr "Odblokowuje miotłę w sklepie. Pcha luźne siano po podłodze z prędkością %.1f m/s."

msgid "SHOP · Broom · $%d"
msgstr "SKLEP · Miotła · $%d"

msgid "Better Broom"
msgstr "Lepsza miotła"

msgid "Each level lets the broom sweep a wider patch of floor."
msgstr "Każdy poziom pozwala miotle zamiatać szerszy kawałek podłogi."

msgid "Bucket Licence"
msgstr "Licencja: Wiadro"

msgid "Unlocks the bucket in the shop. Holds %d pieces of hay and empties at %d a second."
msgstr "Odblokowuje wiadro w sklepie. Mieści %d kawałków siana i wysypuje %d na sekundę."

msgid "SHOP · Bucket · $%d"
msgstr "SKLEP · Wiadro · $%d"

msgid "Bigger Bucket"
msgstr "Większe wiadro"

msgid "Each level lets the bucket hold about a third more hay."
msgstr "Z każdym poziomem wiadro mieści mniej więcej o jedną trzecią siana więcej."

msgid " pieces"
msgstr " szt."

msgid "Wheelbarrow Licence"
msgstr "Licencja: Taczka"

msgid "Unlocks the wheelbarrow in the shop. Holds %d pieces and empties at %d a second. A bucket empties at %d."
msgstr "Odblokowuje taczkę w sklepie. Mieści %d kawałków i wysypuje %d na sekundę. Wiadro wysypuje %d."

msgid "SHOP · Wheelbarrow · $%d"
msgstr "SKLEP · Taczka · $%d"

msgid "Bigger Wheelbarrow"
msgstr "Większa taczka"

msgid "Each level lets the wheelbarrow hold about a fifth more hay."
msgstr "Z każdym poziomem taczka mieści mniej więcej o jedną piątą siana więcej."

msgid "Dump Hatch Plans"
msgstr "Plan: Klapa zsypowa"

msgid "Unlocks the Dump Hatch, $%d each. Walk up to it with a full bucket or barrow and it empties it onto the belt below for you."
msgstr "Odblokowuje klapę zsypową, $%d za sztukę. Podejdź z pełnym wiadrem albo taczką, a opróżni je za ciebie na taśmę pod spodem."

msgid "BUILD · Dump Hatch · $%d"
msgstr "BUDUJ · Klapa zsypowa · $%d"

msgid "Smooth Pouring"
msgstr "Płynne wysypywanie"

msgid "Each level makes buckets and barrows empty 12% faster. The numbers below are for the bucket."
msgstr "Z każdym poziomem wiadra i taczki opróżniają się o 12% szybciej. Liczby poniżej dotyczą wiadra."

msgid " a second"
msgstr " na sekundę"

msgid "Yard Vac Licence"
msgstr "Licencja: Odkurzacz"

msgid "Unlocks the yard vac in the shop, $%d. Hold left click to suck up hay from the floor or the pile at %d a second. Holds %d pieces. Hold right click to pour it out, or aim at a tipper, a bucket or a barrow to empty it straight in."
msgstr "Odblokowuje odkurzacz w sklepie, $%d. Przytrzymaj lewy przycisk, żeby wciągać siano z podłogi albo ze sterty, %d na sekundę. Mieści %d kawałków. Przytrzymaj prawy przycisk, żeby je wysypać, albo wyceluj w klapę zsypową, wiadro lub taczkę, żeby wysypać je prosto do środka."

msgid "SHOP · Yard Vac · $%d"
msgstr "SKLEP · Odkurzacz · $%d"

msgid "Bigger Vac Bin"
msgstr "Większy pojemnik odkurzacza"

msgid "Each level lets the yard vac hold 500 more pieces."
msgstr "Z każdym poziomem odkurzacz mieści 500 kawałków więcej."

msgid "Stronger Suction"
msgstr "Mocniejsze ssanie"

msgid "Each level makes the yard vac suck up hay 25% faster, from a wider patch."
msgstr "Z każdym poziomem odkurzacz wciąga siano o 25% szybciej i z szerszego miejsca."

msgid "Lighter Licence"
msgstr "Licencja: Zapalniczka"

msgid "Unlocks the lighter in the shop, $%d. Burns about %d strands. Can be used every %d seconds."
msgstr "Odblokowuje zapalniczkę w sklepie, $%d. Spala około %d źdźbeł. Można jej użyć co %d s."

msgid "SHOP · Lighter · $%d"
msgstr "SKLEP · Zapalniczka · $%d"

msgid "Conveyor Plans"
msgstr "Plan: Taśmociąg"

msgid "Unlocks conveyor belts, $%d a metre. Belts move hay at %.1f m/s."
msgstr "Odblokowuje taśmociągi, $%d za metr. Taśmy wiozą siano z prędkością %.1f m/s."

msgid "BUILD · Conveyor Belt · $%d per metre"
msgstr "BUDUJ · Taśmociąg · $%d za metr"

msgid "Enclosed Conveyor Plans"
msgstr "Plan: Kryty taśmociąg"

msgid "Unlocks enclosed conveyors, $%d a metre. Packaged cargo travels without visible moving objects, which saves performance in large factories. Loose hay cannot enter."
msgstr "Odblokowuje kryte taśmociągi, $%d za metr. Zapakowany ładunek jedzie bez widocznych ruchomych obiektów, co w dużych fabrykach poprawia wydajność. Luźne siano tam nie wejdzie."

msgid "BUILD · Enclosed Conveyor · $%d per metre"
msgstr "BUDUJ · Kryty taśmociąg · $%d za metr"

msgid "Faster Belt Motor"
msgstr "Szybszy silnik taśmy"

msgid "Each level makes all belts 45% faster, including ones already built."
msgstr "Każdy poziom przyspiesza wszystkie taśmy o 45%, także te już zbudowane."

msgid "Platform Plans"
msgstr "Plan: Platforma"

msgid "Unlocks platforms, $%d a square metre. You and your machines can stand on them."
msgstr "Odblokowuje platformy, $%d za metr kwadratowy. Możesz na nich stać ty i twoje maszyny."

msgid "BUILD · Platform · $%d per m2"
msgstr "BUDUJ · Platforma · $%d za m2"

msgid "Stairs and Railings"
msgstr "Schody i barierki"

msgid "Unlocks stairs ($%d a metre of height) and railings ($%d a metre). Railings are %.2f m tall."
msgstr "Odblokowuje schody ($%d za metr wysokości) i barierki ($%d za metr). Barierki mają %.2f m wysokości."

msgid "BUILD · Stair $%d/m rise · Railing $%d/m"
msgstr "BUDUJ · Schody $%d/m wysokości · Barierka $%d/m"

msgid "Unlocks the Paint Board, $%d. Hold left click to draw and right click to erase."
msgstr "Odblokowuje tablicę do malowania, $%d. Przytrzymaj lewy przycisk, żeby rysować, a prawy, żeby ścierać."

msgid "BUILD · Paint Board · $%d"
msgstr "BUDUJ · Tablica do malowania · $%d"

msgid "Wall Plans"
msgstr "Plan: Ściana"

msgid "Unlocks walls, window walls and doorways, $%d a metre."
msgstr "Odblokowuje ściany, ściany z oknem i ściany z przejściem, $%d za metr."

msgid "BUILD · Wall · Window Wall · $%d per metre"
msgstr "BUDUJ · Ściana · Ściana z oknem · $%d za metr"

msgid "Roof Plans"
msgstr "Plan: Dach"

msgid "Unlocks flat roofs, angled roofs and roof hatches, $%d a metre. Climb onto the roof through a hatch."
msgstr "Odblokowuje dachy płaskie, dachy skośne i włazy dachowe, $%d za metr. Na dach wchodzi się przez właz."

msgid "BUILD · Roof · Angled Roof · Roof Hatch · $%d per metre"
msgstr "BUDUJ · Dach · Dach skośny · Właz dachowy · $%d za metr"

msgid "Unlocks the Work Lamp. Lights up to %d m. Press %s at it to change the brightness. Needs no power. $%d each."
msgstr "Odblokowuje lampę roboczą. Świeci do %d m. Naciśnij %s przy niej, żeby zmienić jasność. Nie potrzebuje prądu. $%d za sztukę."

msgid "BUILD · Work Lamp · $%d"
msgstr "BUDUJ · Lampa robocza · $%d"

msgid "Alternating Splitter"
msgstr "Rozdzielacz naprzemienny"

msgid "Unlocks the splitter, $%d. Splits one belt into two: one load left, the next load right. It can also send everything one way."
msgstr "Odblokowuje rozdzielacz, $%d. Dzieli jedną taśmę na dwie: jeden ładunek w lewo, następny w prawo. Może też wysyłać wszystko w jedną stronę."

msgid "BUILD · Belt Splitter · $%d"
msgstr "BUDUJ · Rozdzielacz taśmy · $%d"

msgid "Splitter Priority"
msgstr "Priorytet rozdzielacza"

msgid "Adds a priority setting to every splitter. The chosen side gets all the hay. The other side only gets hay when the first one is backed up."
msgstr "Dodaje każdemu rozdzielaczowi ustawienie priorytetu. Wybrana strona dostaje całe siano. Druga strona dostaje siano tylko wtedy, gdy pierwsza się zatka."

msgid "SPLITTERS · Priority · one side gets hay first"
msgstr "ROZDZIELACZE · Priorytet · jedna strona dostaje siano pierwsza"

msgid "Unlocks the T Junction, $%d. It sets itself up from the belts you connect: bring one belt in and it splits it into two, bring two belts in and it joins them into one."
msgstr "Odblokowuje węzeł T, $%d. Sam dopasowuje się do taśm, które podłączysz: doprowadź jedną taśmę, a podzieli ją na dwie, doprowadź dwie taśmy, a połączy je w jedną."

msgid "BUILD · T Junction · $%d"
msgstr "BUDUJ · Węzeł T · $%d"

msgid "Compact Splitter Plans"
msgstr "Plan: Rozdzielacz kompaktowy"

msgid "Unlocks the Compact Splitter, $%d. Shares one belt between three belts, taking turns. Works with open and enclosed belts."
msgstr "Odblokowuje rozdzielacz kompaktowy, $%d. Dzieli jedną taśmę po kolei na trzy taśmy. Działa z taśmami otwartymi i krytymi."

msgid "BUILD · Compact Splitter · $%d"
msgstr "BUDUJ · Rozdzielacz kompaktowy · $%d"

msgid "Smart Splitter Plans"
msgstr "Plan: Rozdzielacz inteligentny"

msgid "Unlocks the Smart Splitter, $%d. You pick what may leave through each of its three outputs, so one belt can be sorted by type."
msgstr "Odblokowuje rozdzielacz inteligentny, $%d. Sam wybierasz, co może wyjść każdym z jego trzech wylotów, więc jedną taśmę da się posortować według rodzaju."

msgid "BUILD · Smart Splitter · $%d"
msgstr "BUDUJ · Rozdzielacz inteligentny · $%d"

msgid "Unlocks the joiner, $%d. Merges two belts into one."
msgstr "Odblokowuje łącznik taśm, $%d. Łączy dwie taśmy w jedną."

msgid "BUILD · Belt Joiner · $%d"
msgstr "BUDUJ · Łącznik taśm · $%d"

msgid "Compressor Plans"
msgstr "Plan: Prasa do siana"

msgid "Unlocks the Hay Compressor, $%d. Presses %d straw into a bale every %.1f seconds. Bales sell for %.1fx the price of loose hay."
msgstr "Odblokowuje prasę do siana, $%d. Prasuje %d źdźbeł w belę co %.1f s. Bele sprzedają się za %.1fx cenę luźnego siana."

msgid "BUILD · Hay Compressor · $%d"
msgstr "BUDUJ · Prasa do siana · $%d"

msgid "Larger Bale Chamber"
msgstr "Większa komora bel"

msgid "Each level puts 25% more hay into every bale, so each bale is worth more."
msgstr "Każdy poziom dokłada 25% siana do każdej beli, więc każda bela jest warta więcej."

msgid " a bale"
msgstr " na belę"

msgid "Faster Bale Press"
msgstr "Szybsza prasa bel"

msgid "Each level makes every compressor 8% faster."
msgstr "Każdy poziom przyspiesza każdą prasę o 8%."

msgid " s a bale"
msgstr " s na belę"

msgid "Raise Bale Quality"
msgstr "Lepsza jakość bel"

msgid "Each level makes bales sell for about 7% more."
msgstr "Z każdym poziomem bele sprzedają się za około 7% więcej."

msgid " the hay value"
msgstr " wartości siana"

msgid "Wrapper Plans"
msgstr "Plan: Owijarka bel"

msgid "Unlocks the Hay Wrapper, $%d. Wraps a bale every %.2f seconds. Takes bales only. Wrapped bales sell for %.2fx a bale, which is %.2fx the price of loose hay."
msgstr "Odblokowuje owijarkę bel, $%d. Owija belę co %.2f s. Bierze tylko bele. Bela w folii sprzedaje się za %.2fx tyle co bela, czyli %.2fx cenę luźnego siana."

msgid "BUILD · Hay Wrapper · $%d"
msgstr "BUDUJ · Owijarka bel · $%d"

msgid "Faster Wrapper"
msgstr "Szybsza owijarka"

msgid "Each level makes every wrapper 12% faster. At the top it keeps up with a fully upgraded compressor."
msgstr "Każdy poziom przyspiesza każdą owijarkę o 12%. Na najwyższym poziomie nadąża za w pełni ulepszoną prasą."

msgid "Better Wrap"
msgstr "Lepsza folia"

msgid "Each level makes wrapped bales sell for more."
msgstr "Z każdym poziomem bele w folii sprzedają się drożej."

msgid " the bale value"
msgstr " wartości beli"

msgid "Hay Silo Plans"
msgstr "Plan: Silos na siano"

msgid "Unlocks the Hay Silo, $%d. Put it in a belt line to store hay. Press %s at it to set how fast hay comes out, up to %d loads a minute. Holds %d loads."
msgstr "Odblokowuje silos na siano, $%d. Postaw go na linii taśm, żeby magazynować siano. Naciśnij %s przy nim, żeby ustawić, jak szybko wychodzi siano, do %d ładunków na minutę. Mieści do %d ładunków."

msgid "BUILD · Hay Silo · $%d"
msgstr "BUDUJ · Silos na siano · $%d"

msgid "Faster Silo Output"
msgstr "Szybszy wylot silosu"

msgid "Each level raises the silo's top speed by 20 loads a minute."
msgstr "Każdy poziom podnosi najwyższą prędkość silosu o 20 ładunków na minutę."

msgid " loads a minute"
msgstr " ładunków/min"

msgid "Bigger Silo"
msgstr "Większy silos"

msgid "Each level lets a silo hold about a quarter more."
msgstr "Z każdym poziomem silos mieści mniej więcej o jedną czwartą więcej."

msgid " loads"
msgstr " ładunków"

msgid "Fuller Silo Loads"
msgstr "Pełniejsze ładunki z silosu"

msgid "Each level puts 25% more loose hay into every load the silo lets out. Bales and bricks do not change."
msgstr "Każdy poziom dokłada 25% luźnego siana do każdego ładunku z silosu. Bele i brykiety się nie zmieniają."

msgid " a load"
msgstr " na ładunek"

msgid "Unlocks Hay Stairs, $%d. Belts cannot go down slopes steeper than %d degrees. Drop hay in the top and it comes out on a belt at the bottom."
msgstr "Odblokowuje schody dla siana, $%d. Taśma nie zjedzie po spadku bardziej stromym niż %d stopni. Wrzuć siano od góry, a wyjdzie na taśmę na dole."

msgid "BUILD · Hay Stairs · $%d"
msgstr "BUDUJ · Schody dla siana · $%d"

msgid "Unlocks the Hay Lift, from $%d. Carries hay straight up. Click the bottom, look up and click the top. Lifts %s m, and each extra metre costs $%d."
msgstr "Odblokowuje windę na siano, od $%d. Wynosi siano prosto w górę. Kliknij dół, spójrz w górę i kliknij górę. Podnosi na %s m, a każdy dodatkowy metr kosztuje $%d."

msgid "BUILD · Hay Lift · from $%d"
msgstr "BUDUJ · Winda na siano · od $%d"

msgid "Pelletizer Plans"
msgstr "Plan: Brykieciarka"

msgid "Unlocks the Hay Pelletizer, $%d. Turns %d straw into a fuel brick every %.1f seconds and throws it out. Bricks sell for %.1fx the price of loose hay."
msgstr "Odblokowuje brykieciarkę, $%d. Robi z %d źdźbeł brykiet co %.1f s i go wyrzuca. Brykiety sprzedają się za %.1fx cenę luźnego siana."

msgid "BUILD · Hay Pelletizer · $%d"
msgstr "BUDUJ · Brykieciarka · $%d"

msgid "Tube Launcher Plans"
msgstr "Plan: Wyrzutnia rurowa"

msgid "Unlocks the Tube Launcher, $%d. Throws whatever a belt brings it. Set the angle and power at the machine."
msgstr "Odblokowuje wyrzutnię rurową, $%d. Wyrzuca wszystko, co przywiezie taśma. Kąt i siłę ustawiasz przy maszynie."

msgid "BUILD · Tube Launcher · $%d"
msgstr "BUDUJ · Wyrzutnia rurowa · $%d"

msgid "Electricity"
msgstr "Elektryczność"

msgid "Unlocks the Hay Generator ($%d) and Power Poles ($%d). The generator burns hay and makes %.0f kW. Machines within %d m of a pole get power. Belts do not need power."
msgstr "Odblokowuje generator na siano ($%d) i słupy prądu ($%d). Generator spala siano i daje %.0f kW. Maszyny w promieniu %d m od słupa dostają prąd. Taśmy nie potrzebują prądu."

msgid "BUILD · Hay Generator · $%d · Power Pole · $%d"
msgstr "BUDUJ · Generator na siano · $%d · Słup prądu · $%d"

msgid "Carries power. Poles up to %d m apart connect. Machines within %d m get power if nothing blocks the wire. Comes with Electricity."
msgstr "Przesyła prąd. Słupy oddalone do %d m łączą się. Maszyny w promieniu %d m dostają prąd, jeśli nic nie blokuje przewodu. Dostajesz go z kartą Elektryczność."

msgid "BUILD · Power Pole · $%d"
msgstr "BUDUJ · Słup prądu · $%d"

msgid "Stronger Generator"
msgstr "Mocniejszy generator"

msgid "Each level raises how much power a generator can make. It still needs enough hay to get there."
msgstr "Każdy poziom podnosi, ile prądu może dać generator. Nadal potrzebuje do tego dość siana."

msgid "Borehole Plans"
msgstr "Plan: Pompa głębinowa"

msgid "Unlocks the Borehole Pump, $%d. Pumps %.0f litres of water a second and uses %.0f kW. Pipe the water to a pulper."
msgstr "Odblokowuje pompę głębinową, $%d. Pompuje %.0f litrów wody na sekundę i zużywa %.0f kW. Doprowadź wodę rurą do pulpownicy."

msgid "BUILD · Borehole Pump · $%d"
msgstr "BUDUJ · Pompa głębinowa · $%d"

msgid "Deeper Bore"
msgstr "Głębszy odwiert"

msgid "Each level makes every pump bring up more water. It does not use more power."
msgstr "Z każdym poziomem każda pompa daje więcej wody. Nie zużywa więcej prądu."

msgid " litres a second"
msgstr " l/s"

msgid "Water Mains"
msgstr "Wodociąg"

msgid "Unlocks water pipes, $%d a metre. Click the shiny flange on one machine, then on another. Both ends must be on a flange."
msgstr "Odblokowuje rury wodne, $%d za metr. Kliknij błyszczący kołnierz na jednej maszynie, potem na drugiej. Oba końce muszą być na kołnierzu."

msgid "BUILD · Water Pipe · $%d/m"
msgstr "BUDUJ · Rura wodna · $%d/m"

msgid "Gas Plant Plans"
msgstr "Plan: Elektrownia gazowa"

msgid "Unlocks the Gas Plant, $%d. It burns only eco bricks and gets %d times as much power from each straw as a Hay Generator. Makes up to %.0f kW and needs %.0f litres of water a second, so pipe it from a pump."
msgstr "Odblokowuje elektrownię gazową, $%d. Spala tylko ekobrykiety i z każdego źdźbła daje %d razy więcej prądu niż generator na siano. Daje do %.0f kW i potrzebuje %.0f litrów wody na sekundę, więc doprowadź do niej rurę od pompy."

msgid "BUILD · Gas Plant · $%d"
msgstr "BUDUJ · Elektrownia gazowa · $%d"

msgid "Bigger Gas Plant"
msgstr "Większa elektrownia gazowa"

msgid "Each level raises how much power a gas plant can make. It needs more bricks and more water to get there."
msgstr "Każdy poziom podnosi, ile prądu może dać elektrownia gazowa. Potrzebuje do tego więcej brykietów i więcej wody."

msgid "Longer Spans"
msgstr "Dłuższe linie"

msgid "Each level lets poles and cable boxes connect from 1.5 m further apart."
msgstr "Z każdym poziomem słupy i skrzynki kablowe łączą się z odległości większej o 1.5 m."

msgid " m between poles"
msgstr " m między słupami"

msgid "Longer Drops"
msgstr "Dłuższe kable"

msgid "Each level lets poles and cable boxes power machines 1 m further away."
msgstr "Z każdym poziomem słupy i skrzynki kablowe zasilają maszyny o 1 m dalej."

msgid " m to a machine"
msgstr " m do maszyny"

msgid "Underground Cable"
msgstr "Kabel podziemny"

msgid "Unlocks Cable Boxes, $%d. Works like a pole, but the cable is underground so walls cannot block it. Connects up to %d m away and powers machines within %d m. Hold one to see the cables."
msgstr "Odblokowuje skrzynki kablowe, $%d. Działa jak słup, ale kabel jest pod ziemią, więc ściany go nie blokują. Łączy się do %d m i zasila maszyny w promieniu %d m. Weź jedną do ręki, żeby zobaczyć kable."

msgid "BUILD · Cable Box · $%d"
msgstr "BUDUJ · Skrzynka kablowa · $%d"

msgid "Bigger Firebox"
msgstr "Większe palenisko"

msgid "Each level lets generators hold 25%% more hay. A full generator now lasts %d minutes at full power, and about %d minutes at max level."
msgstr "Z każdym poziomem generatory mieszczą 25%% więcej siana. Pełny generator wystarcza teraz na %d min pełnej mocy, a na najwyższym poziomie na około %d min."

msgid " in the box"
msgstr " w palenisku"

msgid "Bigger Brick Die"
msgstr "Większa forma brykietu"

msgid "Each level puts 25%% more hay into every brick, so bricks sell for more and burn longer. A feed disc still takes %d bricks, so discs are worth more too."
msgstr "Każdy poziom dokłada 25%% siana do każdego brykietu, więc brykiety sprzedają się drożej i palą dłużej. Krążek paszy nadal zużywa %d szt. brykietów, więc krążki też są warte więcej."

msgid " a brick"
msgstr " na brykiet"

msgid "Faster Grinding"
msgstr "Szybsze mielenie"

msgid "Each level makes every pelletizer 8% faster."
msgstr "Każdy poziom przyspiesza każdą brykieciarkę o 8%."

msgid " s a brick"
msgstr " s na brykiet"

msgid "Raise Brick Quality"
msgstr "Lepsza jakość brykietów"

msgid "Each level makes bricks sell for about 6% more."
msgstr "Z każdym poziomem brykiety sprzedają się za około 6% więcej."

msgid "Pulper Plans"
msgstr "Plan: Pulpownica"

msgid "BUILD · Hay Pulper · $%d"
msgstr "BUDUJ · Pulpownica · $%d"

msgid "Bigger Pulp Slabs"
msgstr "Większe płyty pulpy"

msgid "Each level puts 25% more hay into every slab. Slabs sell for more and use the same water."
msgstr "Każdy poziom dokłada 25% siana do każdej płyty. Płyty sprzedają się drożej i zużywają tyle samo wody."

msgid " a slab"
msgstr " na płytę"

msgid "Faster Drum"
msgstr "Szybszy bęben"

msgid "Each level makes every pulper 8% faster. A faster pulper also uses water faster."
msgstr "Każdy poziom przyspiesza każdą pulpownicę o 8%. Szybsza pulpownica szybciej zużywa też wodę."

msgid " s a slab"
msgstr " s na płytę"

msgid "Raise Pulp Quality"
msgstr "Lepsza jakość pulpy"

msgid "Each level makes slabs sell for more."
msgstr "Z każdym poziomem płyty sprzedają się drożej."

msgid "Paper Mill Plans"
msgstr "Plan: Papiernia"

msgid "BUILD · Paper Mill · $%d"
msgstr "BUDUJ · Papiernia · $%d"

msgid "Faster Winder"
msgstr "Szybsza nawijarka"

msgid "Each level makes every paper mill 8% faster. It also uses slabs faster."
msgstr "Każdy poziom przyspiesza każdą papiernię o 8%. Szybciej zużywa też płyty."

msgid " s a roll"
msgstr " s na rolkę"

msgid "Finer Paper"
msgstr "Lepszy papier"

msgid "Each level makes paper rolls sell for more."
msgstr "Z każdym poziomem rolki papieru sprzedają się drożej."

msgid " the slab value"
msgstr " wartości płyty"

msgid "Feed Disc Press Plans"
msgstr "Plan: Prasa do krążków paszy"

msgid "Unlocks the Feed Disc Press, $%d. Presses hay from one belt and eco bricks from another into feed discs. Discs sell for %.2fx the price of loose hay. Each disc uses %d straw and %d bricks. Any size of brick counts as one brick. It is %d m long, has a side input and uses %.1f kW."
msgstr "Odblokowuje prasę do krążków paszy, $%d. Prasuje siano z jednej taśmy i ekobrykiety z drugiej w krążki paszy. Krążki sprzedają się za %.2fx cenę luźnego siana. Każdy krążek zużywa %d źdźbeł i %d szt. brykietów. Brykiet każdej wielkości liczy się jako jeden. Ma %d m długości, wejście z boku i zużywa %.1f kW."

msgid "BUILD · Feed Disc Press · $%d"
msgstr "BUDUJ · Prasa do krążków paszy · $%d"

msgid "Faster Disc Press"
msgstr "Szybsza prasa do krążków"

msgid "Each level makes every disc press 8% faster. It also uses hay and bricks faster."
msgstr "Każdy poziom przyspiesza każdą prasę do krążków o 8%. Szybciej zużywa też siano i brykiety."

msgid " s a disc"
msgstr " s na krążek"

msgid "Better Feed"
msgstr "Lepsza pasza"

msgid "Each level makes feed discs sell for more."
msgstr "Z każdym poziomem krążki paszy sprzedają się drożej."

msgid " the loose hay value"
msgstr " wartości luźnego siana"

msgid "Extend the Shed"
msgstr "Powiększ szopę"

msgid "Each level makes the shed 6 m wider and 6 m longer."
msgstr "Każdy poziom poszerza i wydłuża szopę o 6 m."

msgid " m across"
msgstr " m szerokości"

msgid "Waste Less Material"
msgstr "Mniej odpadów"

msgid "Each level takes 5% off the price of belts, platforms, stairs, railings, walls and roofs. Machines still cost full price."
msgstr "Każdy poziom obniża o 5% cenę taśm, platform, schodów, barierek, ścian i dachów. Maszyny dalej kosztują pełną cenę."

msgid "Hay Piston Rake"
msgstr "Grabie tłokowe do siana"

msgid "Unlocks the Piston Rake, $%d. Digs into the pile and throws the hay behind it every %.1f seconds. Throws %d straw at a time and uses %.0f kW, or %.0f kW with Wider Rake Head. Must face the pile."
msgstr "Odblokowuje grabie tłokowe, $%d. Co %.1f s kopią w stercie i rzucają siano za siebie. Rzucają %d źdźbeł naraz i zużywają %.0f kW, a z kartą Szersza głowica grabi %.0f kW. Muszą stać przodem do sterty."

msgid "BUILD · Piston Rake · $%d"
msgstr "BUDUJ · Grabie tłokowe · $%d"

msgid "Wider Rake Head"
msgstr "Szersza głowica grabi"

msgid "Level 1 raises each throw from %d straw to 50, and each rake then uses %.0f kW instead of %.0f kW. Each level after that adds 25%%."
msgstr "Poziom 1 zwiększa każdy rzut z %d źdźbeł do 50, a każde grabie zużywają wtedy %.0f kW zamiast %.0f kW. Każdy kolejny poziom dodaje 25%%."

msgid " a stroke"
msgstr " na ruch"

msgid "Faster Rake"
msgstr "Szybsze grabie"

msgid "Each level makes every rake 8% faster."
msgstr "Każdy poziom przyspiesza wszystkie grabie o 8%."

msgid " s a stroke"
msgstr " s na ruch"

msgid "Rake Wheels"
msgstr "Koła do grabi"

msgid "Adds Forward and Back buttons to every piston rake. Move a rake a little closer to the pile without taking it down. It stops by itself if something is in the way."
msgstr "Dodaje wszystkim grabiom tłokowym przyciski Do przodu i Do tyłu. Przesuniesz grabie trochę bliżej stogu bez rozbierania. Same się zatrzymają, gdy coś stoi na drodze."

msgid "RAKES · Forward and Back · move without taking down"
msgstr "GRABIE · Do przodu i Do tyłu · przesuwanie bez rozbierania"

msgid "Small Arm Plans"
msgstr "Plan: Małe ramię"

msgid "Unlocks the Small Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second)."
msgstr "Odblokowuje małe ramię, $%d. Sięga %.2f m i przenosi %d źdźbeł co %.2f s (%.1f na sekundę)."

msgid "BUILD · Small Arm · $%d"
msgstr "BUDUJ · Małe ramię · $%d"

msgid "Standard Arm Plans"
msgstr "Plan: Zwykłe ramię"

msgid "Unlocks the Standard Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second, %d%% more). Uses %.1f kW instead of %.1f. Arms you already built stay the size they are."
msgstr "Odblokowuje zwykłe ramię, $%d. Sięga %.2f m i przenosi %d źdźbeł co %.2f s (%.1f na sekundę, o %d%% więcej). Zużywa %.1f kW zamiast %.1f. Już postawione ramiona zostają takie, jakie są."

msgid "BUILD · Standard Arm · $%d"
msgstr "BUDUJ · Zwykłe ramię · $%d"

msgid "Long-Reach Arm Plans"
msgstr "Plan: Długie ramię"

msgid "Unlocks the Long-Reach Arm, $%d. Reaches %.2f m and moves %d straw every %.2f seconds (%.1f a second, %d%% more). Uses %.1f kW instead of %.1f. Arms you already built stay the size they are."
msgstr "Odblokowuje długie ramię, $%d. Sięga %.2f m i przenosi %d źdźbeł co %.2f s (%.1f na sekundę, o %d%% więcej). Zużywa %.1f kW zamiast %.1f. Już postawione ramiona zostają takie, jakie są."

msgid "BUILD · Long-Reach Arm · $%d"
msgstr "BUDUJ · Długie ramię · $%d"

msgid "Belt Links"
msgstr "Łącza taśm"

msgid "Choose the belts an arm works with. It takes from one belt and puts on another. Tick one kind on its plate and it sorts that kind off the belt."
msgstr "Wybierz taśmy, z którymi pracuje ramię. Bierze z jednej taśmy i odkłada na drugą. Zaznacz na nim jeden rodzaj, a będzie go zdejmować z taśmy."

msgid "ARMS · Belt Links · choose where it takes and puts"
msgstr "RAMIONA · Łącza taśm · wybierz, skąd bierze i gdzie odkłada"

msgid "Overflow Arm"
msgstr "Ramię przelewowe"

msgid "An arm can leave a belt alone while it moves, and only take from it when the belt gets stuck. Tick it under TAKE FROM on the arm."
msgstr "Ramię może zostawić taśmę w spokoju, gdy jedzie, i brać z niej dopiero, gdy się zatnie. Zaznacz to na ramieniu pod BIERZE Z."

msgid "ARMS · Overflow · helps out when a belt gets stuck"
msgstr "RAMIONA · Przelew · pomaga, gdy taśma się zatnie"

msgid "Pick Order"
msgstr "Kolejność chwytania"

msgid "Choose what each arm grabs first: loose hay, the biggest things, or whatever is closest. Needles always come first."
msgstr "Wybierz, co każde ramię chwyta najpierw: luźne siano, największe rzeczy albo to, co najbliżej. Igły zawsze są pierwsze."

msgid "ARMS · Pick Order · choose what it grabs first"
msgstr "RAMIONA · Kolejność chwytania · wybierz, co chwyta najpierw"

msgid "Hay Drone Plans"
msgstr "Plan: Dron do siana"

msgid "Unlocks the Hay Drone, $%d. Each extra drone costs %.2fx the last. Give it a zone on the pile and a drop point up to %.0f m away: it digs the zone and flies the hay to the drop."
msgstr ""

msgid "BUILD · Hay Drone · $%d"
msgstr "BUDUJ · Dron do siana · $%d"

msgid "Drone Pickup"
msgstr ""

msgid "Drones can collect things as well as dig. Tick what a drone picks up (wads, bales, bricks and more) and it carries them from its zone to its drop."
msgstr ""

msgid "DRONES · Pickup · collect what you tick"
msgstr ""

msgid "Longer Range"
msgstr ""

msgid "Each level lets every drone work %.1f m farther from its pad, and makes its zone %.1f m bigger."
msgstr ""

msgid " m reach"
msgstr " m zasięgu"

msgid "Faster Rotors"
msgstr "Szybsze wirniki"

msgid "Each level makes every drone fly 8% faster."
msgstr "Z każdym poziomem każdy dron lata o 8% szybciej."

msgid "Arm Speed"
msgstr "Szybkość ramienia"

msgid "Each level makes every arm 8% faster."
msgstr "Każdy poziom przyspiesza każde ramię o 8%."

msgid " faster"
msgstr " szybciej"

msgid "Arm Carry Size"
msgstr "Udźwig ramienia"

msgid "Each level lets every arm carry 8% more."
msgstr "Z każdym poziomem każde ramię nosi o 8% więcej."

msgid "Scanner Mk I Plans"
msgstr "Plan: Skaner Mk I"

msgid "Unlocks the Scanner Mk I, $%d. Put it on a belt. Checks %d straw every %.1f seconds (%.1f a second) for needles. Stops the belt when it finds one, until you empty the drawer. The drawer holds %d."
msgstr "Odblokowuje skaner Mk I, $%d. Postaw go na taśmie. Sprawdza %d źdźbeł co %.1f s (%.1f na sekundę) w poszukiwaniu igieł. Gdy znajdzie igłę, zatrzymuje taśmę, aż opróżnisz szufladę. Szuflada mieści do %d igieł."

msgid "BUILD · Scanner Mk I · $%d"
msgstr "BUDUJ · Skaner Mk I · $%d"

msgid "Unlocks the Needle Cabinet, $%d. One per yard. Has a slot for each of the %d kinds of needle."
msgstr "Odblokowuje szafkę na igły, $%d. Jedna na plac. Ma przegródkę na każdy z %d rodzajów igieł."

msgid "BUILD · Needle Cabinet · $%d"
msgstr "BUDUJ · Szafka na igły · $%d"

msgid "Scanner Mk II Plans"
msgstr "Plan: Skaner Mk II"

msgid "Upgrades all scanners to Mk II, $%d. Does not stop the belt when it finds a needle. Checks %.1f straw a second (Mk I: %.1f, so %d%% faster) and a bale in %.1f seconds (Mk I: %.1f)."
msgstr "Ulepsza wszystkie skanery do Mk II, $%d. Nie zatrzymuje taśmy, gdy znajdzie igłę. Sprawdza %.1f źdźbła na sekundę (Mk I: %.1f, czyli o %d%% szybciej) i belę w %.1f s (Mk I: %.1f)."

msgid "UPGRADE · Scanner Mk II · $%d  ·  every scanner you own"
msgstr "ULEPSZENIE · Skaner Mk II · $%d  ·  wszystkie twoje skanery"

msgid "Satellite Dish Mk I Plans"
msgstr "Plan: Antena satelitarna Mk I"

msgid "Unlocks the Satellite Dish, $%d. One per yard. Scans the pile and puts a circle around every needle within %d m for %d seconds. Recharges in %d seconds."
msgstr "Odblokowuje antenę satelitarną, $%d. Jedna na plac. Skanuje stertę i zaznacza kołem każdą igłę w promieniu %d m na %d s. Ładuje się ponownie w %d s."

msgid "BUILD · Satellite Dish · $%d"
msgstr "BUDUJ · Antena satelitarna · $%d"

msgid "Satellite Dish Mk II Plans"
msgstr "Plan: Antena satelitarna Mk II"

msgid "Upgrades the dish. Shows the exact spot of every needle in range for %d seconds."
msgstr "Ulepsza antenę. Pokazuje dokładne miejsce każdej igły w zasięgu przez %d s."

msgid "UPGRADE · Satellite Dish Mk II  ·  exact spots"
msgstr "ULEPSZENIE · Antena satelitarna Mk II  ·  dokładne miejsca"

msgid "Satellite Dish Mk III Plans"
msgstr "Plan: Antena satelitarna Mk III"

msgid "Upgrades the dish. Needle markers last %d seconds instead of %d."
msgstr "Ulepsza antenę. Znaczniki igieł trwają %d s zamiast %d."

msgid "UPGRADE · Satellite Dish Mk III  ·  markers last %d s"
msgstr "ULEPSZENIE · Antena satelitarna Mk III  ·  znaczniki na %d s"

msgid "Satellite Dish Mk IV Plans"
msgstr "Plan: Antena satelitarna Mk IV"

msgid "Upgrades the dish. Markers also show how deep each needle is. They last %d seconds."
msgstr "Ulepsza antenę. Znaczniki pokazują też, jak głęboko jest każda igła. Trwają %d s."

msgid "UPGRADE · Satellite Dish Mk IV  ·  shows depth"
msgstr "ULEPSZENIE · Antena satelitarna Mk IV  ·  pokazuje głębokość"

msgid "Scan Batch Size"
msgstr "Większa porcja skanu"

msgid "Each level lets scanners check 25% more hay at once."
msgstr "Z każdym poziomem skanery sprawdzają naraz o 25% więcej siana."

msgid "Scan Cycle Speed"
msgstr "Szybszy skan"

msgid "Each level makes scanners check loose hay 8% faster. Bales and bricks do not change."
msgstr "Z każdym poziomem skanery sprawdzają luźne siano o 8% szybciej. Bele i brykiety się nie zmieniają."

msgid "Scan Bigger Blocks"
msgstr "Skanuj większe bloki"

msgid "Scanners check bales and bricks one at a time: %.1f seconds each on a Mk I, %.1f on a Mk II. Each level makes this 12%% faster."
msgstr "Skanery sprawdzają bele i brykiety pojedynczo: po %.1f s na Mk I, %.1f na Mk II. Każdy poziom przyspiesza to o 12%%."

msgid " s a block"
msgstr " s na blok"

msgid "Unlocks the metal detector in the shop, $%d. Beeps faster the closer you are to a needle, but does not show which way. Reaches %.1f m, less through hay."
msgstr "Odblokowuje wykrywacz metalu w sklepie, $%d. Piszczy szybciej, im bliżej jesteś igły, ale nie pokazuje kierunku. Sięga %.1f m, przez siano mniej."

msgid "SHOP · Metal Detector · $%d"
msgstr "SKLEP · Wykrywacz metalu · $%d"

msgid "Bigger Coil"
msgstr "Większa cewka"

msgid "Each level makes the metal detector reach 18% further."
msgstr "Z każdym poziomem wykrywacz metalu sięga o 18% dalej."

msgid " in the open"
msgstr " w powietrzu"

msgid "Bigger Drawer"
msgstr "Większa szuflada"

msgid "Each level lets scanner drawers hold 4 more needles."
msgstr "Z każdym poziomem szuflady skanerów mieszczą 4 igły więcej."

msgid " needles"
msgstr " igieł"

msgid "Better Bargaining"
msgstr "Lepsze targowanie"

msgid "Each level makes everything sell for 5% more."
msgstr "Z każdym poziomem wszystko sprzedaje się za 5% więcej."

msgid " the base price"
msgstr " ceny bazowej"

msgid "Yard Boots"
msgstr "Robocze buty"

msgid "Each level makes you walk and run 4% faster."
msgstr "Z każdym poziomem chodzisz i biegasz o 4% szybciej."

msgid " m/s walking"
msgstr " m/s pieszo"

msgid "Strong Back"
msgstr "Mocne plecy"

msgid "Each level gives you 15% more stamina."
msgstr "Każdy poziom daje ci 15% więcej kondycji."

msgid " stamina"
msgstr " kondycji"

msgid "Carry More"
msgstr "Noś więcej"

msgid "Each level lets you carry one more bale, wad or brick. They stack up in your arms, and E puts the top one down."
msgstr "Każdy poziom pozwala nieść o jedną belę, jeden kłąb lub jeden brykiet więcej. Układają się w stos na rękach, a E odkłada ten z góry."

msgid " in your arms"
msgstr " na rękach"

msgid "Each level makes stamina come back 18% faster."
msgstr "Z każdym poziomem kondycja wraca o 18% szybciej."

msgid "Easy Swing"
msgstr "Lekki zamach"

msgid "Each level makes digging use 8% less stamina."
msgstr "Z każdym poziomem kopanie zużywa o 8% mniej kondycji."

msgid "Each level makes you spill 8% less hay while running."
msgstr "Z każdym poziomem gubisz w biegu o 8% mniej siana."

msgid " sway and spill"
msgstr " bujanie i sypanie"

msgid "Careful Steps"
msgstr "Ostrożne kroki"

msgid "Each level makes you walk 5% faster while crouching."
msgstr "Z każdym poziomem chodzisz w kucki o 5% szybciej."

msgid " m/s crouching"
msgstr " m/s w kucki"

msgid "Longer Reach"
msgstr "Dłuższy zasięg"

msgid "Each level lets you pick things up from 30 cm further away."
msgstr "Z każdym poziomem podnosisz rzeczy z odległości większej o 30 cm."

msgid "Spring Heels"
msgstr "Sprężyste nogi"

msgid "Each level makes you jump 5 cm higher."
msgstr "Z każdym poziomem skaczesz o 5 cm wyżej."

msgid "Jetpack"
msgstr "Plecak odrzutowy"

msgid "You wear a jetpack. Jump, then hold jump in the air to fly. A full tank lasts %d seconds and refills in about %d seconds after you land. Hold an eco brick and press E to refill it at once."
msgstr "Masz plecak odrzutowy. Skocz, a potem przytrzymaj skok w powietrzu, żeby lecieć. Pełny zbiornik starcza na %d s i napełnia się w około %d s po wylądowaniu. Trzymaj ekobrykiet i naciśnij E, żeby od razu go napełnić."

msgid "WORN · Jetpack · jump, then jump again to fly"
msgstr "ZAŁOŻONY · Plecak odrzutowy · skocz, potem skocz jeszcze raz, żeby lecieć"

msgid "Grippy Boots"
msgstr ""

msgid "Your boots grip the rubber, so a running belt no longer pushes you along. Walk on your belts any way you like."
msgstr ""

msgid "WORN · Grippy Boots · belts no longer carry you"
msgstr ""

msgid "Soft Landings"
msgstr "Miękkie lądowanie"

msgid "Each level makes you spill 10% less hay when you jump."
msgstr "Z każdym poziomem gubisz przy skoku o 10% mniej siana."

msgid " jump jolt"
msgstr " wstrząs przy skoku"

msgid "Longer Tape Measure"
msgstr "Dłuższa miarka"

msgid "Each level lets you place buildings 50 cm further away."
msgstr "Z każdym poziomem stawiasz budynki o 50 cm dalej."

msgid "1 step"
msgstr "1 krok"

msgid "%d steps"
msgstr "kroki: %d"

msgid "Unlocks the Hay Pulper, $%d. Mixes %d straw with %.0f litres of water into a pulp slab. Slabs sell for %.1fx the price of loose hay. Needs hay, power and a water pipe."
msgstr "Odblokowuje pulpownicę, $%d. Miesza %d źdźbeł z %.0f litrami wody w płytę pulpy. Płyty sprzedają się za %.1fx cenę luźnego siana. Potrzebuje siana, prądu i rury wodnej."

msgid "Unlocks the Paper Mill, $%d. Turns %d pulp slabs into a paper roll worth %.2fx the slabs. It is %d m long and uses %.0f kW."
msgstr "Odblokowuje papiernię, $%d. Robi z płyt pulpy (%d) rolkę papieru wartą %.2fx tyle co płyty. Ma %d m długości i zużywa %.0f kW."

msgid "%s upgrades"
msgstr "Ulepszenia: %s"

msgid "THE VAC IS FULL  ·  HOLD RIGHT CLICK TO EMPTY IT"
msgstr "ODKURZACZ PEŁNY  ·  PRZYTRZYMAJ PPM, ŻEBY GO OPRÓŻNIĆ"

msgid "OUT OF REACH"
msgstr "POZA ZASIĘGIEM"

msgid "CAN'T LINK"
msgstr "NIE DA SIĘ PODŁĄCZYĆ"

msgid "TAKE FROM"
msgstr "BIERZE Z"

msgid "PUT ON"
msgstr "ODKŁADA NA"

msgid "DONE"
msgstr "GOTOWE"

msgid "Arms cannot link a splitter. Link the belt going in or out of it."
msgstr "Ramienia nie da się podłączyć do rozdzielacza. Podłącz taśmę, która do niego wchodzi albo z niego wychodzi."

msgid "Arms cannot link a joiner. Link the belt going in or out of it."
msgstr "Ramienia nie da się podłączyć do łącznika. Podłącz taśmę, która do niego wchodzi albo z niego wychodzi."

msgid "This belt is enclosed, so the arm cannot reach inside it."
msgstr "Ta taśma jest kryta, więc ramię nie sięgnie do środka."

msgid "Look at a belt near the arm."
msgstr "Spójrz na taśmę obok ramienia."

msgid "Out of reach. The arm cannot get to this belt."
msgstr "Poza zasięgiem. Ramię nie sięga tej taśmy."

msgid "It takes from this belt. Click again to unlink."
msgstr "Bierze z tej taśmy. Kliknij znowu, żeby odłączyć."

msgid "It puts on this belt. Click again to unlink."
msgstr "Odkłada na tę taśmę. Kliknij znowu, żeby odłączyć."

msgid "In reach. Click to link this belt."
msgstr "W zasięgu. Kliknij, żeby podłączyć taśmę."

msgid "LOW POWER  ·  %d%%"
msgstr ""

msgid "WHERE IT TAKES AND PUTS"
msgstr "SKĄD BIERZE I GDZIE ODKŁADA"

msgid "WHERE IT PUTS IT"
msgstr "GDZIE ODKŁADA"

msgid "Any belt in its radius. There is none yet, so lay one beside it."
msgstr "Dowolna taśma w zasięgu. Na razie nie ma żadnej, więc połóż jedną obok."

msgid "Any belt in its radius. 1 belt right now."
msgstr "Dowolna taśma w zasięgu. Teraz jest 1 taśma."

msgid "Any belt in its radius. %d belt right now, taking turns."
msgid_plural "Any belt in its radius. %d belts right now, taking turns."

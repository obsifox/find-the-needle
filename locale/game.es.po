msgid_plural "%d / %d BALES"
msgstr[0] "%d / %d PACA"
msgstr[1] "%d / %d PACAS"

msgid "%d / %d WRAPPED"
msgid_plural "%d / %d WRAPPED"
msgstr[0] "%d / %d ENVUELTA"
msgstr[1] "%d / %d ENVUELTAS"

msgid "%d / %d BRICK"
msgid_plural "%d / %d BRICKS"
msgstr[0] "%d / %d BRIQUETA"
msgstr[1] "%d / %d BRIQUETAS"

msgid "%d / %d DISC"
msgid_plural "%d / %d DISCS"
msgstr[0] "%d / %d DISCO"
msgstr[1] "%d / %d DISCOS"

msgid "%d / %d SLAB"
msgid_plural "%d / %d SLABS"
msgstr[0] "%d / %d PLACA"
msgstr[1] "%d / %d PLACAS"

msgid "%d / %d ROLL"
msgid_plural "%d / %d ROLLS"
msgstr[0] "%d / %d ROLLO"
msgstr[1] "%d / %d ROLLOS"

msgid "TRUCK ON ITS WAY: %s"
msgstr "CAMIÓN EN CAMINO: %s"

msgid "TRUCK DUE ON THE FIRST %s"
msgstr "EL CAMIÓN VIENE CON LA PRIMERA UNIDAD: %s"

msgid "TRUCK AT THE DOOR"
msgstr "CAMIÓN EN LA PUERTA"

msgid "TRUCK ARRIVING"
msgstr "CAMIÓN LLEGANDO"

msgid "$%.4f\nPER STRAND"
msgstr "$%.4f\nPOR BRIZNA"

msgid "%s SOLD\n+$%s"
msgstr "VENDIDO: %s\n+$%s"

msgid "NEW BEST: $%s"
msgstr "NUEVO RÉCORD: $%s"

msgid "%s LOST\n+$%s"
msgstr "PERDIDA: %s\n+$%s"

msgid "Pick up some hay"
msgstr "Recoge un poco de heno"

msgid "Look at the haystack. Hold {primary} to pull out hay. Your hand takes only one straw at a time. A shovel takes much more."
msgstr "Mira el pajar. Mantén {primary} para sacar heno. Con la mano coges solo una brizna cada vez. Con una pala coges mucho más."

msgid "Throw the hay"
msgstr "Lanza el heno"

msgid "Press {secondary} to throw the hay you are holding."
msgstr "Pulsa {secondary} para lanzar el heno que llevas."

msgid "Look where you want it, then let go"
msgstr "Mira adonde lo quieres y suéltalo"

msgid "Run"
msgstr "Corre"

msgid "Hold {sprint} while you walk to run. Running tires you out. Walk for a moment and you can run again."
msgstr "Mantén {sprint} mientras andas para correr. Correr cansa. Anda un rato y podrás volver a correr."

msgid "Hold it while you walk"
msgstr "Mantenlo pulsado mientras andas"

msgid "Sell hay at the stand"
msgstr "Vende heno en el puesto"

msgid "The selling stand is in the far corner. Walk there. Stand at the open bay and press {primary} to drop the hay in. You get money for it."
msgstr "El puesto de venta está en la esquina del fondo. Ve hasta allí. Colócate delante de la abertura y pulsa {primary} para echar el heno dentro. Te dan dinero por él."

msgid "Open the tech tree"
msgstr "Abre el árbol tecnológico"

msgid "Press {tech_tree} to open the tech tree. Buy machines and upgrades here. Press {tech_tree} again to close it."
msgstr "Pulsa {tech_tree} para abrir el árbol tecnológico. Aquí compras las máquinas y las mejoras. Vuelve a pulsar {tech_tree} para cerrarlo."

msgid "Buy Bigger Handful"
msgstr "Compra la carta Puñado más grande"

msgid "Press {tech_tree}. Find the Bigger Handful card and click it. It costs {cost:hand_carry}. Now your hand holds two straws at a time. Buy more levels to hold even more."
msgstr "Pulsa {tech_tree}. Busca la carta Puñado más grande y haz clic en ella. Cuesta {cost:hand_carry}. Así coges dos briznas cada vez con la mano. Compra más niveles para coger todavía más."

msgid "Buy the Toy Shovel card"
msgstr "Compra la carta Pala de playa"

msgid "Sell hay until the bar is full. Every level of Bigger Handful you buy on the way fills it faster. Then press {tech_tree}. Find the Toy Shovel card and click it. It costs {cost:sand_shovel}. The card does not give you a shovel. It puts one in the shop, and the {price:sand_shovel} you have left buys it."
msgstr "Vende heno hasta que la barra se llene. Cada nivel de Puñado más grande que compres por el camino la llena más rápido. Luego pulsa {tech_tree}. Busca la carta Pala de playa y haz clic en ella. Cuesta {cost:sand_shovel}. Esto no te da una pala. Pone una a la venta en la tienda, y con los {price:sand_shovel} que te quedan la compras."

msgid "Find the supply shop"
msgstr "Encuentra la tienda"

msgid "The shop is the other corner building. Walk to the counter. Press {interact} to open the shop."
msgstr "La tienda es el edificio de la otra esquina. Ve hasta el mostrador. Pulsa {interact} para abrirla."

msgid "Buy the toy shovel"
msgstr "Compra la pala de playa"

msgid "Click Toy Shovel to buy it."
msgstr "Haz clic en Pala de playa para comprarla."

msgid "Pick the shovel up"
msgstr "Recoge la pala"

msgid "The shop drops what you buy at your feet. Look down at the shovel. Press {interact} to pick it up. It takes the second box on the bar, next to your hand. Press {hotbar_2} to take it out again, and {hotbar_1} to go back to bare hands."
msgstr "La tienda te deja lo que compras a los pies. Mira la pala en el suelo. Pulsa {interact} para recogerla. Se pone en la segunda casilla de la barra, al lado de tu mano. Pulsa {hotbar_2} para volver a sacarla y {hotbar_1} para volver a las manos desnudas."

msgid "Dig a scoop"
msgstr "Excava una palada"

msgid "Point at the haystack. Press {primary} to dig. The hay sits on the blade and stays there. Now you can carry it anywhere."
msgstr "Apunta al pajar. Pulsa {primary} para excavar. El heno se queda encima de la pala. Ahora puedes llevarlo a donde quieras."

msgid "Take a second scoop"
msgstr "Coge una segunda palada"

msgid "Press {primary} two more times. Each dig adds more hay to the shovel."
msgstr "Pulsa {primary} dos veces más. Cada golpe añade más heno a la pala."

msgid "The shovel keeps what it has"
msgstr "La pala se queda con lo que lleva"

msgid "Practise tipping"
msgstr "Practica cómo inclinar la pala"

msgid "Hold {secondary} and move the mouse to tip the shovel. Do this ten times."
msgstr "Mantén {secondary} y mueve el ratón para inclinar la pala. Hazlo diez veces."

msgid "Empty the blade"
msgstr "Vacía la pala"

msgid "Point where you want the hay. Press {secondary}. The whole load goes there. Do this three times."
msgstr "Apunta adonde quieras el heno. Pulsa {secondary}. Toda la carga va allí. Hazlo tres veces."

msgid "Get a bucket"
msgstr "Consigue un cubo"

msgid "Press {tech_tree}. Buy the Bucket Licence for {cost:bucket}. Then buy the bucket in the shop for {price:bucket}. It holds much more hay than a shovel."
msgstr "Pulsa {tech_tree}. Compra la Licencia del cubo por {cost:bucket}. Luego compra el cubo en la tienda por {price:bucket}. Guarda mucho más heno que una pala."

msgid "Fill the bucket"
msgstr "Llena el cubo"

msgid "Put the bucket on the ground. Press {primary} to dig hay. Now AIM AT THE BUCKET and hold {secondary}, turning the blade over. The hay drops in."
msgstr "Deja el cubo en el suelo. Pulsa {primary} para excavar heno. Ahora APUNTA AL CUBO y mantén {secondary} para volcar la pala. El heno cae dentro."

msgid "Aim at the bucket, then let the hay go"
msgstr "Apunta al cubo y luego suelta el heno"

msgid "Put the bucket on the ground. Press {primary} to dig hay. Now AIM AT THE BUCKET and press {secondary}. The whole load goes where you are looking."
msgstr "Deja el cubo en el suelo. Pulsa {primary} para excavar heno. Ahora APUNTA AL CUBO y pulsa {secondary}. Toda la carga va adonde estés mirando."

msgid "Empty it into the stand"
msgstr "Vacíalo en el puesto"

msgid "Press {interact} to pick the bucket up. Carry it to the stand. Stand at the open bay. Hold {secondary} to tip the hay in."
msgstr "Pulsa {interact} para coger el cubo. Llévalo al puesto. Colócate delante de la abertura. Mantén {secondary} para echar el heno dentro."

msgid "The bucket empties only when you tilt it"
msgstr "El cubo solo se vacía si lo inclinas"

msgid "Earn thirty dollars"
msgstr "Gana treinta dólares"

msgid "Sell hay until the bar is full. Buying things on the way does not slow the bar down. The spade costs {cost:spade} for the card and {price:spade} for the spade itself."
msgstr "Vende paja hasta llenar la barra. Comprar cosas por el camino no la frena. La pala cuesta {cost:spade} la carta y {price:spade} la pala en sí."

msgid "Buy the spade"
msgstr "Compra la pala"

msgid "Press {tech_tree}. Buy the Spade card for {cost:spade}. Then buy the spade in the shop for {price:spade}. Press {interact} to pick it up. It goes in the next free box on your bar."
msgstr "Pulsa {tech_tree}. Compra la carta Pala por {cost:spade}. Luego compra la pala en la tienda por {price:spade}. Pulsa {interact} para recogerla. Se pone en la siguiente casilla libre de tu barra."

msgid "The card is in the tech tree, the spade is in the shop"
msgstr "La carta está en el árbol tecnológico, la pala está en la tienda"

msgid "Put a tool down"
msgstr "Suelta una herramienta"

msgid "Take a tool in your hands. Press {drop_tool} to put it on the ground, or {throw_item} to throw it. It stays there. Walk to it and press {interact} to pick it up again."
msgstr "Coge una herramienta con las manos. Pulsa {drop_tool} para dejarla en el suelo, o {throw_item} para lanzarla. Se queda ahí. Acércate y pulsa {interact} para volver a cogerla."

msgid "Fetch a lost tool"
msgstr "Recupera una herramienta perdida"

msgid "Press {drop_tool} to put a tool on the ground. Walk to the shop counter and press {interact}. Click BRING TO ME next to that tool. It comes back to your feet."
msgstr "Pulsa {drop_tool} para dejar una herramienta en el suelo. Ve al mostrador de la tienda y pulsa {interact}. Haz clic en TRÁEMELO al lado de esa herramienta. Vuelve a tus pies."

msgid "Open the build catalogue"
msgstr "Abre el catálogo de construcción"

msgid "Press {build_catalog} to open the build catalogue. Buy things in the tech tree, then build them from here."
msgstr "Pulsa {build_catalog} para abrir el catálogo de construcción. Compra cosas en el árbol tecnológico y luego constrúyelas desde aquí."

msgid "Build the needle cabinet"
msgstr "Construye la vitrina de agujas"

msgid "Press {build_catalog} and pick the needle cabinet. It is free. Click a place on the floor to build it."
msgstr "Pulsa {build_catalog} y elige la vitrina de agujas. Es gratis. Haz clic en un sitio del suelo para construirla."

msgid "Your first building is a gift"
msgstr "Tu primer edificio es un regalo"

msgid "Lay your first conveyor"
msgstr "Pon tu primera cinta transportadora"

msgid "Press {tech_tree}. Buy Conveyor Plans for {cost:belt}. Press {build_catalog} and pick the belt. Click once for the start. Click again for the end. Hay on a belt moves by itself."
msgstr "Pulsa {tech_tree}. Compra los Planos de la cinta transportadora por {cost:belt}. Pulsa {build_catalog} y elige la cinta. Haz clic una vez para el principio y otra para el final. El heno que va en una cinta se mueve solo."

msgid "Move it closer or further"
msgstr "Acércalo o aléjalo"

msgid "Press {build_catalog} and pick anything. You now see a copy of it on your cursor. Roll the mouse wheel, or press {build_closer|keys} and {build_further|keys}. The copy moves closer to you and further away."
msgstr "Pulsa {build_catalog} y elige cualquier cosa. Ahora ves una copia pegada al cursor. Mueve la rueda del ratón, o pulsa {build_closer|keys} y {build_further|keys}. La copia se acerca y se aleja de ti."

msgid "Move it away, then bring it back"
msgstr "Aléjala y luego tráela de vuelta"

msgid "Line it up on the grid"
msgstr "Alinéalo con la rejilla"

msgid "Press {build_catalog} and pick a belt or a machine. Press {build_grid}. Squares appear on the floor and your building lines up with them. Press {build_grid} again to turn the grid off."
msgstr "Pulsa {build_catalog} y elige una cinta o una máquina. Pulsa {build_grid}. Aparecen cuadros en el suelo y tu construcción se alinea con ellos. Vuelve a pulsar {build_grid} para quitar la rejilla."

msgid "Neat rows are easier to join up"
msgstr "Las filas ordenadas son más fáciles de conectar"

msgid "Run a belt to the stand"
msgstr "Lleva una cinta hasta el puesto"

msgid "Press {build_catalog} and pick the belt. End the belt at the stand's open bay. Now hay on that belt sells by itself."
msgstr "Pulsa {build_catalog} y elige la cinta. Termina la cinta en la abertura del puesto. Ahora el heno que va por esa cinta se vende solo."

msgid "Turn a belt round"
msgstr "Dale la vuelta a una cinta"

msgid "A belt carries hay one way only. Look at a belt you built. Arrows appear on it showing which way the hay goes. Hold {interact} until they swing round. The belt now runs the other way. It costs nothing and you keep the belt."
msgstr "Una cinta lleva el heno en un solo sentido. Mira una cinta que hayas construido. Aparecen flechas que indican hacia dónde va el heno. Mantén {interact} hasta que den la vuelta. Ahora la cinta va en el otro sentido. No cuesta nada y la cinta sigue siendo tuya."

msgid "The arrows show which way the hay goes"
msgstr "Las flechas indican hacia dónde va el heno"

msgid "Look at your needle cabinet and press {pick_build}. Now you hold one just like it, ready to build. This works on anything you built."
msgstr "Mira tu vitrina de agujas y pulsa {pick_build}. Ahora llevas una igual, lista para construir. Esto funciona con todo lo que hayas construido."

msgid "Quicker than finding it in the list"
msgstr "Más rápido que buscarlo en la lista"

msgid "Take something down again"
msgstr "Desmonta algo"

msgid "Point at anything you built. Hold {dismantle} until it comes down. You get all your money back."
msgstr "Apunta a algo que hayas construido. Mantén {dismantle} hasta que se desmonte. Recuperas todo tu dinero."

msgid "Turn it round"
msgstr "Gíralo"

msgid "Press {build_catalog} and pick something to build. Press {build_rotate}. Each press turns it a quarter."
msgstr "Pulsa {build_catalog} y elige algo para construir. Pulsa {build_rotate}. Cada pulsación lo gira un cuarto de vuelta."

msgid "Machines work only when they face the right way"
msgstr "Las máquinas solo funcionan si miran hacia el lado correcto"

msgid "Get the power running"
msgstr "Pon en marcha la electricidad"

msgid "Buy Electricity and build a Hay Generator. Put hay in it to burn."
msgstr "Compra Electricidad y construye un Generador de heno. Échale paja para que tenga qué quemar."

msgid "Place your free rake"
msgstr "Coloca tu rastrillo gratis"

msgid "Press {build_catalog} and pick the Piston Rake. It is free. Put it in front of the haystack, facing the hay."
msgstr "Pulsa {build_catalog} y elige el Rastrillo de pistón. Es gratis. Ponlo delante del pajar, mirando a la paja."

msgid "Face it at the hay"
msgstr "Mirando a la paja"

msgid "Connect the rake with a power pole"
msgstr "Conecta el rastrillo con un poste eléctrico"

msgid "Build a Power Pole within {num:POLE_SUPPLY_R} metres of the rake and the generator. Then the rake starts working."
msgstr "Construye un Poste eléctrico a {num:POLE_SUPPLY_R} metros o menos del rastrillo y del generador. Entonces el rastrillo se pone a trabajar."

msgid "Set how far the rake throws"
msgstr "Ajusta hasta dónde lanza el rastrillo"

msgid "Press {interact} at the rake. Drag the slider to choose where the hay lands. Make it land on your conveyor, or in a bucket or wheelbarrow."
msgstr "Pulsa {interact} en el rastrillo. Arrastra el control para elegir dónde cae la paja. Haz que caiga en tu cinta transportadora, o en un cubo o una carretilla."

msgid "The marks show where the hay lands"
msgstr "Las marcas indican dónde cae el heno"

msgid "Make your belts faster"
msgstr "Haz que tus cintas vayan más rápido"

msgid "Your belts move hay slowly. Press {tech_tree} and buy the first level of Faster Belt Motor for {cost:belt_speed}. Every belt gets faster, even the ones you already built."
msgstr "Tus cintas mueven el heno despacio. Pulsa {tech_tree} y compra el primer nivel de Motor de cinta más rápido por {cost:belt_speed}. Todas las cintas van más rápido, incluso las que ya has construido."

msgid "Build a robotic arm"
msgstr "Construye un brazo robótico"

msgid "Press {tech_tree}. Buy Small Arm Plans for {cost:arm_small}. Press {build_catalog} and place the arm between the haystack and a belt, {price:arm} to build, with a pole near it. It digs and puts the hay on the belt."
msgstr "Pulsa {tech_tree}. Compra los Planos del brazo pequeño por {cost:arm_small}. Pulsa {build_catalog} y coloca el brazo entre el pajar y una cinta (construirlo cuesta {price:arm}), con un poste cerca. Excava y pone el heno en la cinta."

msgid "Buy the metal detector"
msgstr "Compra el detector de metales"

msgid "Press {tech_tree} and buy the Metal Detector card for {cost:metal_detector}. Then buy the detector in the shop for {price:detector}. It beeps faster the closer you are to a needle. Walk over the pile and listen."
msgstr "Pulsa {tech_tree} y compra la carta Detector de metales por {cost:metal_detector}. Luego compra el detector en la tienda por {price:detector}. Pita más rápido cuanto más cerca estás de una aguja. Camina por encima del montón y escucha."

msgid "Switch the detector on and off"
msgstr "Enciende y apaga el detector"

msgid "Hold the detector. Press {secondary} to turn it on and again to turn it off. Do this three times."
msgstr "Coge el detector. Pulsa {secondary} para encenderlo y otra vez para apagarlo. Hazlo tres veces."

msgid "Down is on, up is off"
msgstr "Abajo encendido, arriba apagado"

msgid "Pin the delivery order"
msgstr "Fija el pedido de entrega"

msgid "The board by the bay door has an order on it. Look at the big sheet on the left and press {interact}. It shows in the corner of your screen."
msgstr "En el tablón que hay junto al portón tienes un pedido. Mira la hoja grande de la izquierda y pulsa {interact}. Aparecerá en la esquina de tu pantalla."

msgid "Press {interact} at the sheet to take the order off your screen, then press {interact} again to put it back."
msgstr "Pulsa {interact} delante de la hoja para quitar el pedido de la pantalla, y vuelve a pulsar {interact} para ponerlo otra vez."

msgid "The order stays on your screen"
msgstr "El pedido se queda en tu pantalla"

msgid "Take the copy down, then put it back up"
msgstr "Quita la copia y vuelve a ponerla"

msgid "Fill the first order"
msgstr "Termina el primer pedido"

msgid "The order wants twenty pressed bales on the truck. Press {tech_tree} and buy Alternating Splitter, then Compressor Plans for {cost:compressor}. Press {build_catalog} and build the press on a belt, {price:compressor} to build, with a pole near it. It presses hay into bales, and bales sell for more. Stack what it makes on the truck bed. The truck comes when you make your first bale."
msgstr "El pedido pide veinte pacas prensadas en el camión. Pulsa {tech_tree} y compra Divisor alterno y luego los Planos de la empacadora por {cost:compressor}. Pulsa {build_catalog} y construye la empacadora sobre una cinta (cuesta {price:compressor}), con un poste cerca. Prensa el heno en pacas, y las pacas se venden más caras. Apila lo que fabrique en la caja del camión. El camión viene en cuanto hagas tu primera paca."

msgid "Build a haystack scanner"
msgstr "Construye un escáner de pajar"

msgid "That order unlocked Scanner Mk I Plans. Press {tech_tree}, buy them for {cost:scanner_mk1}, then press {build_catalog} and place the scanner on a belt, {price:scanner} to build. It finds the needles in the hay that goes past."
msgstr "Ese pedido ha desbloqueado los Planos del escáner Mk I. Pulsa {tech_tree}, cómpralos por {cost:scanner_mk1}, luego pulsa {build_catalog} y coloca el escáner sobre una cinta (cuesta {price:scanner}). Encuentra las agujas en el heno que pasa por delante."

msgid "Fill the wrapped order"
msgstr "Termina el pedido de pacas envueltas"

msgid "The next order on the board wants eighteen wrapped bales. Press {tech_tree} and buy Wrapper Plans for {cost:wrapper}. Press {build_catalog} and build the wrapper on the belt after the press, {price:wrapper} to build. It wraps each bale. Stack the wrapped bales on the truck."
msgstr "El siguiente pedido del tablón pide dieciocho pacas envueltas. Pulsa {tech_tree} y compra los Planos de la envolvedora por {cost:wrapper}. Pulsa {build_catalog} y construye la envolvedora en la cinta, después de la empacadora (cuesta {price:wrapper}). Envuelve cada paca. Apila las pacas envueltas en el camión."

msgid "Build the hay drone"
msgstr "Construye el dron de heno"

msgid "That order unlocked Hay Drone Plans. You also need Long-Reach Arm Plans. Press {tech_tree} and buy those, then Hay Drone Plans for {cost:drone}. Press {build_catalog} to place the drone, {price:drone} to build. Then press {interact} on its pad and give it a zone and a drop. It digs or collects there and flies it all to the drop. No belts needed."
msgstr ""

msgid "Extend the shed"
msgstr "Amplía el cobertizo"

msgid "Press {tech_tree}. Buy Extend the Shed. Each level makes the shed bigger."
msgstr "Pulsa {tech_tree}. Compra Ampliar el cobertizo. Cada nivel agranda el cobertizo."

msgid "Find a needle"
msgstr "Encuentra una aguja"

msgid "Put a needle in the case"
msgstr "Guarda una aguja en la vitrina"

msgid "Carry the needle to the cabinet. Press {interact} to open it. Click the slot that matches your needle."
msgstr "Lleva la aguja hasta la vitrina. Pulsa {interact} para abrirla. Haz clic en el hueco que le corresponde a tu aguja."

msgid "Build a gas plant"
msgstr "Construye una central de gas"

msgid "Hay Generators get 1 kJ from each straw. A Gas Plant gets 3 kJ from each straw in an eco brick. Press {tech_tree} and buy Gas Plant Plans for {cost:gas_plant}. Press {build_catalog} and build it for {price:gas_plant}. Lay a water pipe from a borehole pump to its flange."
msgstr "Los generadores de heno sacan 1 kJ de cada brizna. Una central de gas saca 3 kJ de cada brizna de una ecobriqueta. Pulsa {tech_tree} y compra los Planos de la central de gas por {cost:gas_plant}. Pulsa {build_catalog} y constrúyela por {price:gas_plant}. Tiende una tubería de agua desde una bomba de pozo hasta su brida."

msgid "Feed it bricks"
msgstr "Échale briquetas"

msgid "Run a belt from a pelletizer into the gas plant, or carry bricks to it. It burns eco bricks and nothing else. Put a power pole near it to carry the power."
msgstr "Pon una cinta desde una briquetadora hasta la central de gas, o llévale briquetas a mano. Solo quema ecobriquetas, nada más. Pon un poste eléctrico cerca para llevar la corriente."

msgid "Reward: %s (free)"
msgstr "Premio: %s (gratis)"

msgid "$%s / $%s   ·   $%s left"
msgstr "$%s / $%s   ·   faltan $%s"

msgid "%d%% full"
msgstr "lleno al %d%%"

msgid "%.1fs / %ds"
msgstr "%.1f s / %d s"

msgid "as %s"
msgstr "como %s"

msgid "press %s to see every board"
msgstr "pulsa %s para ver todas las clasificaciones"

msgid "UNRANKED"
msgstr "SIN CLASIFICAR"

msgid "NOT ON THE BOARDS YET"
msgstr "TODAVÍA NO ESTÁS EN LAS CLASIFICACIONES"

msgid "MOST MONEY EARNED   %s"
msgstr "TOTAL GANADO   %s"

msgid "sell some hay and it will be posted for you"
msgstr "vende un poco de heno y tu marca se publicará sola"

msgid "SIGNED OUT"
msgstr "SESIÓN CERRADA"

msgid "OPEN THE LEADERBOARDS TO SIGN IN"
msgstr "ABRE LAS CLASIFICACIONES PARA INICIAR SESIÓN"

msgid "your progress is saved"
msgstr "tu progreso está guardado"

msgid "THE BOARDS CANNOT BE REACHED"
msgstr "NO SE PUEDE CONECTAR CON LAS CLASIFICACIONES"

msgid "your progress is saved, your rank will show later"
msgstr "tu progreso está guardado, tu puesto se verá más tarde"

msgid "YOUR RANK"
msgstr "TU PUESTO"

msgid "OPEN THE LEADERBOARDS TO SEE IT"
msgstr "ABRE LAS CLASIFICACIONES PARA VERLO"

msgid "NO BOARDS"
msgstr "SIN CLASIFICACIONES"

msgid "SWITCHED OFF IN THIS BUILD"
msgstr "DESACTIVADAS EN ESTA VERSIÓN"

msgid "CONNECTING"
msgstr "CONECTANDO"

msgid "LOADING"
msgstr "CARGANDO"

msgid "not yet"
msgstr "todavía no"

msgid "YARD RECORDS"
msgstr "RÉCORDS DEL PATIO"

msgid "BEST SALE"
msgstr "MEJOR VENTA"

msgid "BEST MINUTE"
msgstr "MEJOR MINUTO"

msgid "HAY SOLD"
msgstr "HENO VENDIDO"

msgid "TAKINGS"
msgstr "RECAUDACIÓN"

msgid "$%s /min"
msgstr "$%s /min"

msgid "%d  (%d of %d)"
msgstr "%d  (%d de %d)"

msgid "ALL YARDS   $%s earned   %dh %02dm played"
msgstr "TODOS LOS PATIOS   $%s ganados   %d h %02d min jugados"

msgid "WARMING UP"
msgstr "CALENTANDO"

msgid "RAISING THE SKY"
msgstr "IZANDO EL CIELO"

msgid "CLEARING THE YARD"
msgstr "DESPEJANDO EL PATIO"


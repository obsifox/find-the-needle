msgstr[1] "içinde saman olan {n} {item}. Önce boşalt"

msgid "a {item} with hay in it. Tip it out first"
msgid_plural "{n} {item}s with hay in them. Tip them out first"
msgstr[0] "içinde saman olan {item}. Önce boşalt"

msgstr "EN BÜYÜK MODEL"

msgid "Can't upgrade: %s."
msgstr "Yükseltilemez: %s."

msgid "UPGRADE TO %s  ·  $%s"
msgstr "YÜKSELT: %s  ·  $%s"


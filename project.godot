; Engine configuration file.
; Generated from project.binary (export).

config_version=5

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[application]
config/name="Haystack Incremental"
config/description="First-person 3D haystack excavation. Find the needle."
config/version="0.1.0"
config/tags=["3d", "physics", "incremental"]
run/main_scene="res://scenes/main_menu.tscn"
config/features=["4.7", "Forward Plus"]
boot_splash/bg_color=Color(0.05999999865889549, 0.06499999761581421, 0.07999999821186066, 1.0)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/boot_splash.png"
config/icon="res://assets/branding/app_icon.png"
run/flush_stdout_on_print.release=true

[autoload]
Cfg="*res://autoload/cfg.gd"
InputSetup="*res://autoload/input_setup.gd"
GameState="*res://autoload/game_state.gd"
Tech="*res://autoload/tech.gd"
SaveManager="*res://autoload/save_manager.gd"
Audio="*res://autoload/audio.gd"
Loading="*res://autoload/loading.gd"
Profile="*res://autoload/profile.gd"
Leaderboard="*res://autoload/leaderboard.gd"
CrashReport="*res://autoload/crash_report.gd"

[debug]
file_logging/max_log_files=20

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]
enabled=["res://addons/terrain_3d/plugin.cfg"]

[internationalization]
locale/translations=["res://locale/game.de.po", "res://locale/game.fr.po", "res://locale/game.es.po", "res://locale/game.pl.po", "res://locale/game.cs.po", "res://locale/game.zh.po", "res://locale/game.ru.po", "res://locale/game.tr.po", "res://locale/game.ja.po", "res://locale/game.ko.po", "res://locale/game.pt_BR.po"]
locale/include_text_server_data=true

[physics]
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.002
jolt_physics_3d/simulation/speculative_contact_distance=0.004
jolt_physics_3d/simulation/sleep_velocity_threshold=0.08
jolt_physics_3d/simulation/sleep_time_threshold=0.4
jolt_physics_3d/limits/max_bodies=32768
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=32768
3d/sleep_threshold_linear=0.08
3d/sleep_threshold_angular=1.0
3d/time_before_sleep=0.4

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
reflections/reflection_atlas/reflection_count=2
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
; MOBILE FIX: MSAA 4x on Mali-G-series mobile drivers is both the single
; biggest per-frame memory cost and a known fault source in the tiled
; renderer; phones get the plain (no-MSAA) pipeline.
anti_aliasing/quality/msaa_3d.mobile=0
occlusion_culling/use_occlusion_culling=true
; ...and no HB occlusion buffers on phones either: the yard is open enough
; that culling barely helps, and the occlusion pass is one more driver edge
; the 71-74% window does not need.
occlusion_culling/use_occlusion_culling.mobile=false
driver/threads/thread_model.template=2
